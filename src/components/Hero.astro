---
import { getLang, t } from '@/lib/i18n';

const lang = getLang(Astro.url.pathname);
---

<section class="hero">
  <div class="inner hero__inner">
    <div class="hero__text reveal center-mobile">
      <h1 class="display display--xl" set:html={t(lang, 'hero.title')} />
      <p class="lead lead--hero">{t(lang, 'hero.sub')}</p>
      <div class="btn-row">
        <a
          class="btn btn--primary"
          href="#rdv"
          data-track-id="hero_book_demo"
          data-track-type="demo"
          data-track-section="hero">{t(lang, 'cta.book_demo')}</a
        >
        <a
          class="btn btn--ghost"
          href="#rdv"
          data-track-id="hero_try_free"
          data-track-type="trial"
          data-track-section="hero">{t(lang, 'cta.try_free')}</a
        >
      </div>
    </div>

    <div class="hero__media reveal">
      <div class="frame frame--portrait">
        <img
          src="/images/agency-meeting.webp"
          alt={lang === 'fr' ? 'Rendez-vous en agence de voyage' : 'Meeting in a travel agency'}
          width="1400"
          height="1750"
          fetchpriority="high"
        />
        <div class="frame__scrim" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

---
// Hero section
import { getLang, t } from '@/lib/i18n';

const lang = getLang(Astro.url.pathname);
---

<!-- ── Hero ── -->
      <section class="hero">
        <div class="hero__backdrop" aria-hidden="true">
          <picture>
            <source srcset="/images/hero.avif" type="image/avif" />
            <source srcset="/images/hero.webp" type="image/webp" />
            <img src="/images/hero.jpg" alt="" width="1672" height="941" decoding="async" fetchpriority="high" />
          </picture>
        </div>
        <div class="inner">
          <div class="hero__content">
            <div class="section__eyebrow hero__kicker">{t(lang, 'hero.kicker')}</div>
            <h1 set:html={t(lang, 'hero.title')} />
            <p class="hero__sub" set:html={t(lang, 'hero.sub')} />
            <div class="hero__actions">
              <a
                class="btn btn--primary btn--lg"
                href="#rdv"
                data-track-id="hero_book_demo"
                data-track-type="demo"
                data-track-section="hero"
                >{t(lang, 'cta.book_demo')}</a
              >
            </div>
            <div class="hero__trust">
              <span>{t(lang, 'hero.trust1')}</span>
              <span class="hero__trust-sep"></span>
              <span>{t(lang, 'hero.trust2')}</span>
              <span class="hero__trust-sep"></span>
              <span>{t(lang, 'hero.trust3')}</span>
            </div>
          </div>
        </div>

      </section>

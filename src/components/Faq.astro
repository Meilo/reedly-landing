---
// FAQ accordion. Also emits the page's FAQPage JSON-LD, so no other component
// on the same page may emit one.
import { getLang, t } from '@/lib/i18n';
import Icon from '@/components/Icon.astro';
import { faqPage } from '@/lib/schema';

const lang = getLang(Astro.url.pathname);
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, 'https://www.reedly.ai').href;

const items = [1, 2, 3, 4, 5, 6].map((i) => ({
  q: t(lang, `faq.q${i}`),
  a: t(lang, `faq.a${i}`),
}));

const faqLD = faqPage(canonical, lang, items);
---

<section class="section" id="faq">
  <div class="inner faq__inner">
    <h2 class="display display--lg faq__title reveal" set:html={t(lang, 'faq.title')} />

    <div class="faq__list reveal">
      {items.map((item, i) => (
        <div class={`faq__item${i === 0 ? ' is-open' : ''}`}>
          <button class="faq__q" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
            <span class="faq__q-text">{item.q}</span>
            <span class="faq__sign" aria-hidden="true">
              <Icon name="plus" size={14} />
            </span>
          </button>
          <div class="faq__panel">
            <p>{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqLD)} />

---
// Faq section. Also emits the page's FAQPage JSON-LD, built from the same
// Q/A pairs actually rendered below (so a page only ever gets one FAQPage,
// and it always matches the visible content). Feature pages build their own
// FAQPage from feature-specific content and don't render this component.
import { getLang, t } from '@/lib/i18n';

const lang = getLang(Astro.url.pathname);

const qaKeys = [
  ['faq.q1', 'faq.a1'],
  ['faq.q2', 'faq.a2'],
  ['faq.q3', 'faq.a3'],
  ['faq.q4', 'faq.a4'],
  ['faq.q5', 'faq.a5'],
  ['faq.q6', 'faq.a6'],
] as const;

const qa = qaKeys.map(([qKey, aKey]) => ({
  question: t(lang, qKey),
  answer: t(lang, aKey),
}));

const faqLD = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: qa.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqLD)} />

<!-- ── FAQ ── -->
      <section class="section section--alt" id="faq">
        <div class="inner">
          <div class="reveal">
            <div class="section__eyebrow">{t(lang, 'faq.eyebrow')}</div>
            <h2>{t(lang, 'faq.title')}</h2>
          </div>
          <div class="faq-list">
            {qa.map((item, i) => (
              <article class={`faq-item reveal reveal-delay-${Math.min(Math.floor(i / 2) + 1, 3)}`} aria-expanded="false">
                <button class="faq-btn" type="button">
                  <span>{item.question}</span>
                  <div class="faq-btn__icon">+</div>
                </button>
                <div class="faq-panel">
                  <p>{item.answer}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

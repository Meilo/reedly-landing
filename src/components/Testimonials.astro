---
import { getLang, t } from '@/lib/i18n';
import Icon from '@/components/Icon.astro';

const lang = getLang(Astro.url.pathname);

const testimonials = [1, 2, 3, 4].map((i) => ({
  quote: t(lang, `tm.q${i}`),
  name: t(lang, `tm.n${i}`),
  role: t(lang, `tm.r${i}`),
}));

const [lead, ...rest] = [testimonials[3], ...testimonials.slice(0, 3)];
---

<section class="section" id="temoignages">
  <div class="inner">
    <div class="tm__head reveal">
      <div class="tm__stars" aria-hidden="true">
        {Array.from({ length: 5 }).map(() => <Icon name="star" size={22} />)}
      </div>
      <h2 class="display display--lg" set:html={t(lang, 'tm.title')} />
    </div>

    <figure class="tm__border tm__lead reveal">
      <div class="tm__lead-in">
        <blockquote><p>{lead.quote}</p></blockquote>
        <figcaption>
          <div class="tm__name">{lead.name}</div>
          <div class="tm__role">{lead.role}</div>
          <div class="tm__rating" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={16} />)}
          </div>
        </figcaption>
      </div>
    </figure>

    <ul class="tm__row reveal">
      {rest.map((s) => (
        <li>
          <div class="tm__rating" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={14} />)}
          </div>
          <p>{s.quote}</p>
          <div>
            <div class="tm__name">{s.name}</div>
            <div class="tm__role">{s.role}</div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

---
// Legal document shell: sticky table of contents beside the sections.
// A section's body is a list of paragraphs; a paragraph may hold inline HTML.
// Optional blocks cover the shapes the documents actually use: bullet lists,
// the cookie table, the sub-processor rows, and a highlighted note.
import Icon from '@/components/Icon.astro';
import type { Lang } from '@/lib/i18n';

interface LegalLink {
  name: string;
  purpose: string;
  url: string;
}

export interface LegalSection {
  /** Anchor id. Derived from the title when omitted. */
  id?: string;
  title: string;
  paragraphs?: string[];
  list?: string[];
  /** Rows of [label, description, duration]; rendered as a bordered stack. */
  rows?: string[][];
  links?: LegalLink[];
  /** Highlighted callout, rendered after the blocks. */
  note?: string;
  /** Plain paragraphs rendered after the blocks. */
  after?: string[];
  /** Small muted caption rendered after the blocks. */
  caption?: string;
}

interface Props {
  title: string;
  lastUpdated: string;
  sections: LegalSection[];
  lang: Lang;
}

const { title, lastUpdated, sections, lang } = Astro.props;

const slugify = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const entries = sections.map((section) => ({ ...section, anchor: section.id ?? slugify(section.title) }));

const backLabel = lang === 'fr' ? "Retour à l'accueil" : 'Back to home';
const tocLabel = lang === 'fr' ? 'Sommaire' : 'Contents';
---

<section class="legal-hero">
  <div class="inner">
    <a class="back-link" href={`/${lang}`}>
      <Icon name="arrow-back" size={16} />
      {backLabel}
    </a>
    <div class="reveal center-mobile">
      <h1>{title}</h1>
      <p class="legal-hero__meta">{lastUpdated}</p>
    </div>
  </div>
</section>

<section class="legal-body">
  <div class="inner legal-body__inner">
    <aside class="legal-toc reveal">
      <div class="legal-toc__title">{tocLabel}</div>
      {entries.map((section) => (
        <a href={`#${section.anchor}`}>{section.title}</a>
      ))}
    </aside>

    <div class="legal-doc">
      {entries.map((section) => (
        <section class="legal-section reveal" id={section.anchor}>
          <h2>{section.title}</h2>

          {section.paragraphs?.map((paragraph) => <p set:html={paragraph} />)}

          {section.list && (
            <ul class="legal-list">
              {section.list.map((item) => (
                <li>
                  <span class="legal-list__dot" aria-hidden="true">•</span>
                  <span set:html={item} />
                </li>
              ))}
            </ul>
          )}

          {section.rows && (
            <div class="legal-stack legal-stack--table">
              {section.rows.map((row) => (
                <div class="legal-stack__row">
                  <span class="legal-stack__label">{row[0]}</span>
                  <span class="legal-stack__desc">{row[1]}</span>
                  {row[2] && <span class="legal-stack__meta">{row[2]}</span>}
                </div>
              ))}
            </div>
          )}

          {section.links && (
            <div class="legal-stack">
              {section.links.map((link) => (
                <a class="legal-stack__row" href={link.url} target="_blank" rel="noopener noreferrer">
                  <span class="legal-stack__label">{link.name}</span>
                  <span class="legal-stack__desc">{link.purpose}</span>
                  <Icon name="external-link" size={16} />
                </a>
              ))}
            </div>
          )}

          {section.after?.map((paragraph) => <p set:html={paragraph} />)}

          {section.caption && <p class="legal-caption" set:html={section.caption} />}

          {section.note && <div class="legal-note" set:html={section.note} />}
        </section>
      ))}
    </div>
  </div>
</section>

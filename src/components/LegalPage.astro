---
// Legal document shell: sticky table of contents beside the sections.
// A section's body is a list of paragraphs; a paragraph may hold inline HTML.
// Optional blocks cover the shapes the documents actually use: bullet lists,
// the cookie table, and the sub-processor cards.
import Icon from '@/components/Icon.astro';
import type { Lang } from '@/lib/i18n';

interface LegalLink {
  name: string;
  purpose: string;
  url: string;
}

export interface LegalSection {
  /** Anchor id. Derived from the title when omitted. */
  id?: string;
  title: string;
  paragraphs?: string[];
  list?: string[];
  table?: { head: string[]; rows: string[][] };
  links?: LegalLink[];
  note?: string;
}

interface Props {
  title: string;
  lastUpdated: string;
  sections: LegalSection[];
  lang: Lang;
}

const { title, lastUpdated, sections, lang } = Astro.props;

const slugify = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const entries = sections.map((section) => ({ ...section, anchor: section.id ?? slugify(section.title) }));

const backLabel = lang === 'fr' ? "Retour à l'accueil" : 'Back to home';
const tocLabel = lang === 'fr' ? 'Sommaire' : 'Contents';
---

<section class="legal-hero">
  <div class="inner">
    <a class="back-link" href={`/${lang}`}>
      <Icon name="arrow-back" size={16} />
      {backLabel}
    </a>
    <div class="reveal center-mobile">
      <h1>{title}</h1>
      <p class="legal-hero__meta">{lastUpdated}</p>
    </div>
  </div>
</section>

<section class="legal-body">
  <div class="inner legal-body__inner">
    <aside class="legal-toc reveal">
      <div class="legal-toc__title">{tocLabel}</div>
      <nav>
        {entries.map((section) => (
          <a href={`#${section.anchor}`}>{section.title}</a>
        ))}
      </nav>
    </aside>

    <div class="legal-doc">
      {entries.map((section) => (
        <section class="legal-section reveal" id={section.anchor}>
          <h2>{section.title}</h2>

          {section.paragraphs?.map((paragraph) => <p set:html={paragraph} />)}

          {section.list && (
            <ul>
              {section.list.map((item) => <li set:html={item} />)}
            </ul>
          )}

          {section.table && (
            <div class="legal-table-wrap">
              <table>
                <thead>
                  <tr>{section.table.head.map((cell) => <th>{cell}</th>)}</tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {section.links && (
            <div class="legal-links">
              {section.links.map((link) => (
                <a class="legal-link" href={link.url} target="_blank" rel="noopener noreferrer">
                  <span class="legal-link__name">{link.name}</span>
                  <span class="legal-link__purpose">{link.purpose}</span>
                  <Icon name="arrow-cta" size={14} />
                </a>
              ))}
            </div>
          )}

          {section.note && <p class="legal-note" set:html={section.note} />}
        </section>
      ))}
    </div>
  </div>
</section>

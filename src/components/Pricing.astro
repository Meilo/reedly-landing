---
// Pricing. Both toggles are wired in public/main.js: it rewrites .js-price
// from data-price-eur / data-price-usd (-14% on annual) and swaps the symbol.
import { getLang, t } from '@/lib/i18n';
import Icon from '@/components/Icon.astro';

const lang = getLang(Astro.url.pathname);

// Euro is the reference on the French page, dollar on the English one. Rendered
// server-side so the right currency is painted on first frame, with no flash.
const currency = lang === 'en' ? 'usd' : 'eur';

const teamFeatures = Array.from({ length: 10 }, (_, i) => ({
  key: `pricing.team.feat${i + 1}`,
  icon: `plan-team-${i + 1}`,
}));
const enterpriseFeatures = Array.from({ length: 5 }, (_, i) => ({
  key: `pricing.large.feat${i + 1}`,
  icon: `plan-enterprise-${i + 1}`,
}));
---

<section class="section section--white" id="pricing">
  <div class="inner">
    <div class="pricing__head reveal center-mobile">
      <div>
        <h2 class="display display--lg" set:html={t(lang, 'pricing.title')} />
        <p class="lead">{t(lang, 'pricing.lead')}</p>
      </div>

      <div class="pricing__toggles">
        <div
          class="billing-toggle"
          id="currency-toggle"
          role="group"
          aria-label={t(lang, 'pricing.currency.aria')}
        >
          <button
            type="button"
            class={currency === 'eur' ? 'is-active' : undefined}
            data-currency="eur"
            data-track-id="pricing_currency_eur"
            data-track-section="pricing">{t(lang, 'pricing.currency.eur')}</button
          >
          <button
            type="button"
            class={currency === 'usd' ? 'is-active' : undefined}
            data-currency="usd"
            data-track-id="pricing_currency_usd"
            data-track-section="pricing">{t(lang, 'pricing.currency.usd')}</button
          >
        </div>

        <div
          class="billing-toggle"
          id="billing-toggle"
          role="group"
          aria-label={t(lang, 'pricing.billing.aria')}
        >
          <button
            type="button"
            class="is-active"
            data-billing="monthly"
            data-track-id="pricing_billing_monthly"
            data-track-section="pricing">{t(lang, 'pricing.billing.monthly')}</button
          >
          <button
            type="button"
            data-billing="annual"
            data-track-id="pricing_billing_annual"
            data-track-section="pricing">{t(lang, 'pricing.billing.annual')}</button
          >
        </div>
      </div>
    </div>

    <div class="pricing__cards reveal">
      <article class="plan plan--team">
        <div class="plan__badge">{t(lang, 'pricing.team.badge')}</div>
        <div class="plan__name">{t(lang, 'pricing.team.plan')}</div>
        <div class="plan__meta">{t(lang, 'pricing.team.subtitle')}</div>

        <div class="plan__price">
          <span class="plan__figure"
            ><span
              class="plan__currency plan__currency--pre js-currency"
              data-currency="usd"
              hidden={currency !== 'usd'}>$</span
            ><span class="plan__amount js-price" data-price-eur="49" data-price-usd="49">49</span
            ><span
              class="plan__currency plan__currency--post js-currency"
              data-currency="eur"
              hidden={currency !== 'eur'}>€</span
            ></span
          >
          <span class="plan__per">{t(lang, 'pricing.team.per')}</span>
        </div>

        <div class="plan__divider"></div>

        <ul class="plan__features">
          {teamFeatures.map((feat) => (
            <li>
              <span class="plan__feature-icon" data-icon-anim><Icon name={feat.icon} size={30} /></span>
              {t(lang, feat.key)}
            </li>
          ))}
        </ul>

        <a
          class="btn btn--primary btn--block plan__cta"
          href="https://hub.reedly.ai/"
          data-track-id="pricing_team_try_free"
          data-track-type="trial"
          data-track-section="pricing">{t(lang, 'cta.try_free')}</a
        >
      </article>

      <article class="plan plan--enterprise">
        <div class="plan__name">{t(lang, 'pricing.large.plan')}</div>
        <div class="plan__meta">{t(lang, 'pricing.large.subtitle')}</div>
        <div class="plan__quote">{t(lang, 'pricing.large.price')}</div>

        <div class="plan__divider"></div>

        <ul class="plan__features">
          {enterpriseFeatures.map((feat) => (
            <li>
              <span class="plan__feature-icon" data-icon-anim><Icon name={feat.icon} size={30} /></span>
              {t(lang, feat.key)}
            </li>
          ))}
        </ul>

        <a
          class="btn btn--onDark btn--block plan__cta"
          href="#rdv"
          data-track-id="pricing_large_contact"
          data-track-type="contact"
          data-track-section="pricing">{t(lang, 'pricing.contact_us')}</a
        >
      </article>
    </div>

  </div>
</section>

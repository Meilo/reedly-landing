---
// Sticky navigation. Collapses into a floating pill on scroll and flips to
// light ink over any section flagged `data-nav-dark` (public/main.js).
import { getLang, t } from '@/lib/i18n';
import Icon from '@/components/Icon.astro';
import FlagFr from '@/components/icons/FlagFr.astro';
import FlagEn from '@/components/icons/FlagEn.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const lang = getLang(path);

interface Props {
  /** Mirror path in the other language, for the language switcher. */
  altHref?: string;
}

const { altHref } = Astro.props;
const otherLang = lang === 'fr' ? 'en' : 'fr';
const otherHref = altHref ?? `/${otherLang}`;
const homeHref = `/${lang}`;
---

<nav class="nav" id="nav">
  <div class="nav__inner">
    <a class="nav__logo" href={homeHref}>
      <img src="/logo-mark.svg" alt="" width="20" height="20" />
      <span>REEDLY</span>
    </a>

    <div class="nav__actions">
      <button
        class="nav__lang-trigger"
        type="button"
        id="nav-lang-trigger"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label={t(lang, 'nav.language')}
      >
        <span class={`nav__flag${lang === 'fr' ? ' nav__flag--fr' : ''}`}>
          {lang === 'fr' ? <FlagFr /> : <FlagEn />}
        </span>
        <Icon name="chevron-down" size={10} />
      </button>

      <a
        class="nav__signin"
        href="https://hub.reedly.ai"
        data-track-id="nav_login"
        data-track-type="login"
        data-track-section="nav">{t(lang, 'nav.login')}</a
      >

      <a
        class="nav__cta"
        href={`${homeHref}#rdv`}
        data-track-id="nav_book_demo"
        data-track-type="demo"
        data-track-section="nav">{t(lang, 'cta.book_demo')}</a
      >
    </div>
  </div>
</nav>

<!--
  Sibling of <nav>, not a descendant of the blurred pill: a backdrop-filter
  nested inside an ancestor that already has one samples that ancestor's
  flattened layer instead of the page, so its blur would do nothing. Its
  position is measured from the trigger in public/main.js.
-->
<div class="nav__lang-panel" id="nav-lang-panel" role="menu">
  <a class="nav__lang-item" role="menuitem" hreflang="en" href={lang === 'fr' ? otherHref : path}>
    <span class="nav__flag"><FlagEn /></span>{t(lang, 'lang.en')}
  </a>
  <a class="nav__lang-item" role="menuitem" hreflang="fr" href={lang === 'fr' ? path : otherHref}>
    <span class="nav__flag nav__flag--fr"><FlagFr /></span>{t(lang, 'lang.fr')}
  </a>
</div>

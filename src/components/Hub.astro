---
import { getLang, t } from '@/lib/i18n';
import Icon from '@/components/Icon.astro';

const lang = getLang(Astro.url.pathname);

const benefits = [
  { title: 'hub.benefit1.title', text: 'hub.benefit1.text', icon: 'unified-view' },
  { title: 'hub.benefit2.title', text: 'hub.benefit2.text', icon: 'trends' },
  { title: 'hub.benefit3.title', text: 'hub.benefit3.text', icon: 'blockers' },
];
---

<section class="section" id="hub">
  <div class="inner">
    <div class="reveal center-mobile">
      <h2 class="display display--lg" set:html={t(lang, 'hub.title')} />
      <p class="lead">{t(lang, 'hub.lead')}</p>
    </div>

    <div class="hub__grid reveal">
      <div class="frame hub__photo">
        <img
          src="/images/sales-director.webp"
          alt={lang === 'fr' ? 'Directrice commerciale' : 'Sales director'}
          width="1122"
          height="1402"
          loading="lazy"
        />
      </div>

      <div class="hub__browser">
        <div class="hub__window">
          <div class="hub__chrome">
            <div class="hub__dots"><span></span><span></span><span></span></div>
            <span>{t(lang, 'hub.max.url')}</span>
          </div>
          <div class="hub__body">
            <img src="/max-creature.png" alt="Max" width="46" height="46" loading="lazy" style="display:block;margin-bottom:12px" />
            <div class="hub__hello">{t(lang, 'hub.max.greeting')}</div>
            <div class="hub__hello-sub">{t(lang, 'hub.max.greeting_sub')}</div>
            <p class="hub__intro">{t(lang, 'hub.max.intro')}</p>

            <div class="hub__tiles">
              <div class="hub__tile">
                <div class="hub__tile-label">{t(lang, 'hub.max.kpi_team')}</div>
                <div class="hub__tile-value">6</div>
              </div>
              <div class="hub__tile">
                <div class="hub__tile-label">{t(lang, 'hub.max.kpi_reports')}</div>
                <div class="hub__tile-value">24</div>
              </div>
              <div class="hub__tile">
                <div class="hub__tile-title">
                  <Icon name="sun" size={14} />
                  <span>{t(lang, 'hub.max.brief_label')}</span>
                </div>
                <div class="hub__tile-text">{t(lang, 'hub.max.brief_text')}</div>
              </div>
              <div class="hub__tile">
                <div class="hub__tile-title">
                  <Icon name="sparkles" size={14} />
                  <span>{t(lang, 'hub.max.insights_label')}</span>
                </div>
                <div class="hub__tile-text">{t(lang, 'hub.max.insights_text')}</div>
              </div>
            </div>

            <div class="hub__composer">
              <span class="hub__composer-text">{t(lang, 'hub.max.composer')}</span>
              <span class="hub__composer-send" aria-hidden="true">
                <Icon name="arrow-cta" size={18} />
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hub__benefits reveal">
      {benefits.map((b) => (
        <article class="hub__benefit">
          <span class="hub__benefit-icon">
            <Icon name={b.icon} size={60} />
          </span>
          <h3>{t(lang, b.title)}</h3>
          <p>{t(lang, b.text)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

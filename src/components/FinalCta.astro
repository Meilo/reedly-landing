---
import { getLang, t } from '@/lib/i18n';

const lang = getLang(Astro.url.pathname);
---

<section class="final-cta" id="cta-final">
  <div class="inner final-cta__inner reveal">
    <h2 class="display display--lg" set:html={t(lang, 'final.title')} />
    <div class="btn-row">
      <a
        class="btn btn--primary"
        href="#rdv"
        data-track-id="final_book_demo"
        data-track-type="demo"
        data-track-section="final_cta">{t(lang, 'cta.book_demo')}</a
      >
      <a
        class="btn btn--ghost"
        href="https://hub.reedly.ai/"
        data-track-id="final_try_free"
        data-track-type="trial"
        data-track-section="final_cta">{t(lang, 'cta.try_free')}</a
      >
    </div>
  </div>
</section>

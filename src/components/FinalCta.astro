---
// FinalCta section, closing "book a demo" band (stores moved to the footer).
import { getLang, t } from '@/lib/i18n';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const lang = getLang(path);
const bookHref = `/${lang}#rdv`;
---

<!-- ── Final CTA ── -->
      <section class="final-cta" id="final-cta">
        <div class="inner">
          <div class="final-cta__box reveal">
            <div>
              <h2 set:html={t(lang, 'cta.title')} />
              <p class="final-cta__sub">{t(lang, 'cta.sub')}</p>
            </div>
            <div class="final-cta__action">
              <a
                class="btn btn--primary btn--lg"
                href={bookHref}
                data-link-fr="/fr#rdv"
                data-link-en="/en#rdv"
                data-track-id="final_book_demo"
                data-track-type="demo"
                data-track-section="final_cta"
                >{t(lang, 'cta.book_demo')}</a
              >
            </div>
          </div>
        </div>

        <style>
          .final-cta__action {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
          }
        </style>
      </section>

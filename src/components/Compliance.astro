---
import { getLang, t } from '@/lib/i18n';
import Icon from '@/components/Icon.astro';

const lang = getLang(Astro.url.pathname);
const privacyHref = lang === 'fr' ? '/fr/confidentialite' : '/en/privacy-policy';

const items = [
  { key: 'compliance.item1', icon: 'eu-hosting' },
  { key: 'compliance.item2', icon: 'dpa' },
  { key: 'compliance.item3', icon: 'subprocessors' },
  { key: 'compliance.item4', icon: 'encryption' },
  { key: 'compliance.item5', icon: 'deletion' },
  { key: 'compliance.item6', icon: 'consent' },
];
---

<section class="section section--dark" id="conformite" data-nav-dark>
  <div class="inner compliance__inner">
    <div class="compliance__head reveal center-mobile">
      <h2 class="display display--lg" set:html={t(lang, 'compliance.title')} />
      <p class="lead">{t(lang, 'compliance.lead')}</p>
    </div>

    <ul class="compliance__list reveal">
      {items.map((item) => (
        <li>
          <span class="compliance__icon"><Icon name={item.icon} size={16} /></span>
          {item.key === 'compliance.item3' ? (
            <a href={`${privacyHref}#sous-traitants`}>{t(lang, item.key)}</a>
          ) : (
            <span>{t(lang, item.key)}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

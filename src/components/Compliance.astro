---
// Compliance & security section: the quiet trust beat after the 360° Hub.
// Each line is a guarantee, laid out as a GDPR "compliance sheet".
import { getLang, t } from '@/lib/i18n';

const lang = getLang(Astro.url.pathname);

const items = [
  {
    key: 'compliance.item1',
    icon: '<path d="M12 21s-6-5.4-6-10a6 6 0 1 1 12 0c0 4.6-6 10-6 10z" /><circle cx="12" cy="11" r="2.2" />',
  },
  {
    key: 'compliance.item2',
    icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" />',
  },
  {
    key: 'compliance.item3',
    icon: '<path d="M9 6h11M9 12h11M9 18h11" /><path d="M4 6h.01M4 12h.01M4 18h.01" />',
    linkFr: '/fr/confidentialite#sous-traitants',
    linkEn: '/en/privacy-policy#sous-traitants',
  },
  {
    key: 'compliance.item4',
    icon: '<rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4M12 15v2" />',
  },
  {
    key: 'compliance.item5',
    icon: '<path d="M4 7h16M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M6 7l1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13" />',
  },
  {
    key: 'compliance.item6',
    icon: '<path d="M12 3l7 3v5c0 4.6-3 7.6-7 9-4-1.4-7-4.4-7-9V6z" /><path d="M9 12l2 2 4-4" />',
  },
];
---

<!-- ── Compliance & security ── -->
      <section class="section cf" id="conformite">
        <div class="inner">
          <div class="cf-grid">
            <div class="cf-rail reveal">
              <div class="section__eyebrow">{t(lang, 'compliance.eyebrow')}</div>
              <h2 set:html={t(lang, 'compliance.title')} />
              <p class="section__lead">{t(lang, 'compliance.lead')}</p>
            </div>

            <div class="cf-sheet reveal reveal-delay-1">
              <div class="cf-sheet__head">
                <span class="cf-sheet__lock" aria-hidden="true">
                  <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8">
                    <rect x="5" y="11" width="14" height="9" rx="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 0 1 8 0v4" />
                  </svg>
                </span>
                <span class="cf-sheet__title">{t(lang, 'compliance.panel')}</span>
                <span class="cf-sheet__seal" aria-hidden="true"></span>
              </div>
              <ul class="cf-list">
                {items.map((item) => (
                  <li class="cf-item">
                    <span class="cf-item__ico" aria-hidden="true">
                      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                    </span>
                    {item.linkFr ? (
                      <a
                        class="cf-item__label cf-item__label--link"
                        href={lang === 'fr' ? item.linkFr : item.linkEn}
                        data-link-fr={item.linkFr}
                        data-link-en={item.linkEn}
                      >
                        {t(lang, item.key)}
                      </a>
                    ) : (
                      <span class="cf-item__label">{t(lang, item.key)}</span>
                    )}
                    <span class="cf-item__tick" aria-hidden="true">
                      <svg fill="none" viewBox="0 0 24 24" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 12.5l5 5L20 6.5" />
                      </svg>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

<style>
  .cf { border-top: 1px solid var(--border); }

  .cf-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .cf-rail h2 { max-width: 16ch; }
  .cf-rail .section__lead { max-width: 42ch; }

  /* The sheet: a framed GDPR register that echoes the Hub mock-window chrome. */
  .cf-sheet {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
  }

  .cf-sheet__head {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 13px 18px;
    background: rgba(11, 18, 32, 0.55);
    border-bottom: 1px solid var(--border);
  }
  :global(html[data-theme='light']) .cf-sheet__head {
    background: rgba(148, 163, 184, 0.1);
  }

  .cf-sheet__lock {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
  }
  .cf-sheet__lock svg { width: 15px; height: 15px; stroke: var(--green); }

  .cf-sheet__title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text);
  }

  .cf-sheet__seal {
    margin-left: auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 4px var(--green-glow);
  }

  .cf-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cf-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 20px;
    border-top: 1px solid var(--border);
    transition: background 0.2s ease;
  }
  /* Register ruling: first row has no top rule; second column gets a left rule. */
  .cf-item:nth-child(1),
  .cf-item:nth-child(2) { border-top: none; }
  .cf-item:nth-child(even) { border-left: 1px solid var(--border); }

  .cf-item:hover { background: rgba(34, 197, 94, 0.045); }

  .cf-item__ico {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--green-glow);
    border: 1px solid var(--border-bright);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .cf-item__ico svg { width: 16px; height: 16px; stroke: var(--green); }

  .cf-item__label {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--text);
    font-weight: 500;
    padding-right: 20px;
  }

  /* item 3 links to the published subprocessor list in the privacy policy */
  a.cf-item__label--link {
    text-decoration: none;
    text-decoration-color: var(--border-bright);
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  a.cf-item__label--link:hover {
    color: var(--green);
    text-decoration: underline;
  }

  .cf-item__tick {
    position: absolute;
    top: 20px;
    right: 16px;
    color: var(--green);
    opacity: 0.85;
  }
  .cf-item__tick svg { width: 15px; height: 15px; stroke: currentColor; }

  @media (max-width: 860px) {
    .cf-grid { grid-template-columns: 1fr; gap: 32px; align-items: start; }
    .cf-rail h2 { max-width: none; }
    .cf-list { grid-template-columns: 1fr; }
    .cf-item:nth-child(2) { border-top: 1px solid var(--border); }
    .cf-item:nth-child(even) { border-left: none; }
  }
</style>

---
// Footer: oversized wordmark fading into the dark band, then the link columns.
import { getLang, t } from '@/lib/i18n';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const lang = getLang(path);
const home = `/${lang}`;
const year = String(new Date().getFullYear());

const legal =
  lang === 'fr'
    ? {
        notice: '/fr/mentions-legales',
        privacy: '/fr/confidentialite',
        cookies: '/fr/cookies',
        terms: '/fr/cgu',
      }
    : {
        notice: '/en/legal-notice',
        privacy: '/en/privacy-policy',
        cookies: '/en/cookie-policy',
        terms: '/en/terms-of-service',
      };

const features =
  lang === 'fr'
    ? { transcription: '/fr/features/transcription-ia', hub: '/fr/features/hub-manager' }
    : { transcription: '/en/features/ai-transcription', hub: '/en/features/manager-hub' };
---

<footer class="footer">
  <div class="footer__spacer" aria-hidden="true"></div>
  <div class="footer__wordmark" aria-hidden="true">REEDLY</div>

  <div class="footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href={home}>
        <img src="/logo-mark.svg" alt="Reedly" width="26" height="26" />
        <span set:html={t(lang, 'footer.tagline')} />
      </a>

      <div class="footer__stores">
        <a
          class="store-badge"
          href="https://apps.apple.com/fr/app/reedly-rapport-g%C3%A9n%C3%A9r%C3%A9-par-ia/id6760261826"
          target="_blank"
          rel="noopener noreferrer"
          data-track-id="footer_store_ios"
          data-track-type="download"
          data-track-section="footer"
        >
          <svg width="18" height="18" viewBox="0 0 814 1000" aria-hidden="true"
            ><path
              d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-57.8-155.5-127.4C46 790.7 0 663 0 541.8c0-207.3 133.4-316.9 264.6-316.9 70.1 0 128.4 46.4 172.1 46.4 41.8 0 107.2-49.1 183.2-49.1 29.2 0 130.4 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
            ></path></svg
          >
          <span class="store-badge__text">
            <span class="store-badge__sub">{t(lang, 'cta.store_sub')}</span>
            <span class="store-badge__name">App Store</span>
          </span>
        </a>
        <a
          class="store-badge"
          href="https://play.google.com/store/apps/details?id=com.reedly.app"
          target="_blank"
          rel="noopener noreferrer"
          data-track-id="footer_store_android"
          data-track-type="download"
          data-track-section="footer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M6.97395 19.9739C6.89234 20.0554 6.99001 20.1878 7.09146 20.133C9.67967 18.7329 13.174 16.8415 16.1272 15.2376C16.1862 15.2055 16.1971 15.1258 16.1492 15.0787L14.0683 13.0298C14.0292 12.9913 13.9663 12.9915 13.9275 13.0303L6.97395 19.9739Z"
            ></path>
            <path
              d="M13.921 10.776C13.9601 10.8148 14.0232 10.8146 14.0621 10.7757L16.1439 8.6959C16.1912 8.64857 16.1796 8.56896 16.1207 8.53716L15.1007 7.98656C13.8742 7.32459 12.2308 6.43768 10.563 5.53787C9.31392 4.864 8.05241 4.1836 6.94227 3.58516C6.84062 3.53036 6.74247 3.66293 6.8245 3.74421L13.921 10.776Z"
            ></path>
            <path
              d="M3 3.19622C3 2.9639 3.03514 2.76941 3.09628 2.6092C3.15947 2.44364 3.36802 2.43096 3.4939 2.55569L12.8585 11.8349C12.8979 11.8739 12.898 11.9376 12.8587 11.9768L3.46006 21.3475C3.3216 21.4856 3.09274 21.4522 3.04845 21.2617C3.01631 21.1235 3 20.9702 3 20.8055V3.19622Z"
            ></path>
            <path
              d="M17.6882 14.3886C17.6495 14.4096 17.6016 14.4029 17.5703 14.372L15.1324 11.9723C15.0927 11.9333 15.0926 11.8694 15.132 11.8301L17.5831 9.39339C17.6145 9.36219 17.6629 9.3555 17.7018 9.37668C19.7881 10.5145 21.4155 11.398 21.9117 11.6605C21.9302 11.6703 21.9447 11.6851 21.953 11.7044C21.9983 11.8088 22.0087 11.9126 21.9933 12.0125C21.9889 12.0414 21.9701 12.0651 21.9443 12.0787C21.6589 12.2291 20.7033 12.7489 19.3724 13.4728C18.8548 13.7543 18.2906 14.0612 17.6882 14.3886Z"
            ></path>
          </svg>
          <span class="store-badge__text">
            <span class="store-badge__sub">{t(lang, 'cta.store_sub')}</span>
            <span class="store-badge__name">Google Play</span>
          </span>
        </a>
      </div>
    </div>

    <div class="footer__col">
      <div class="footer__col-title">{t(lang, 'footer.col.product')}</div>
      <a href={`${home}#rdv`}>{t(lang, 'footer.book_demo')}</a>
      <a href={`${home}#pricing`}>{t(lang, 'footer.pricing')}</a>
      <a href={`${home}#faq`}>FAQ</a>
    </div>

    <div class="footer__col">
      <div class="footer__col-title">{t(lang, 'footer.col.features')}</div>
      <a href={features.transcription}>{t(lang, 'footer.feature.transcription')}</a>
      <a href={features.hub}>{t(lang, 'footer.feature.hub')}</a>
    </div>

    <div class="footer__col">
      <div class="footer__col-title">{t(lang, 'footer.col.social')}</div>
      <a
        href="https://www.linkedin.com/company/reedly/"
        target="_blank"
        rel="noopener noreferrer"
        data-track-id="footer_social_linkedin"
        data-track-type="social"
        data-track-section="footer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4.75 1.875C3.57639 1.875 2.625 2.82639 2.625 4C2.625 5.1736 3.57639 6.125 4.75 6.125C5.9236 6.125 6.875 5.1736 6.875 4C6.875 2.82639 5.9236 1.875 4.75 1.875Z"
          ></path>
          <path
            d="M2.75 7.875C2.68096 7.875 2.625 7.93096 2.625 8V21C2.625 21.069 2.68096 21.125 2.75 21.125H6.75C6.81904 21.125 6.875 21.069 6.875 21V8C6.875 7.93096 6.81904 7.875 6.75 7.875H2.75Z"
          ></path>
          <path
            d="M9.25 7.875C9.18096 7.875 9.125 7.93096 9.125 8V21C9.125 21.069 9.18096 21.125 9.25 21.125H13.25C13.319 21.125 13.375 21.069 13.375 21V14C13.375 13.5027 13.5725 13.0258 13.9242 12.6742C14.2758 12.3225 14.7527 12.125 15.25 12.125C15.7473 12.125 16.2242 12.3225 16.5758 12.6742C16.9275 13.0258 17.125 13.5027 17.125 14V21C17.125 21.069 17.181 21.125 17.25 21.125H21.25C21.319 21.125 21.375 21.069 21.375 21V12.3802C21.375 9.9535 19.2644 8.05499 16.8498 8.2745C16.1052 8.34219 15.369 8.52731 14.6815 8.82194L13.375 9.38186V8C13.375 7.93096 13.319 7.875 13.25 7.875H9.25Z"
          ></path>
        </svg>LinkedIn
      </a>
      <a
        href="https://www.instagram.com/reedly.ai/"
        target="_blank"
        rel="noopener noreferrer"
        data-track-id="footer_social_instagram"
        data-track-type="social"
        data-track-section="footer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 8.75005C10.2051 8.75005 8.75 10.2051 8.75 12C8.75 13.795 10.2051 15.25 12 15.25C13.7949 15.25 15.25 13.795 15.25 12C15.25 10.2051 13.7949 8.75005 12 8.75005Z"
          ></path>
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M6.76954 3.08151C10.2177 2.69614 13.7824 2.69614 17.2305 3.08151C19.1289 3.29369 20.6601 4.78947 20.8829 6.69452C21.2952 10.2195 21.2952 13.7806 20.8829 17.3056C20.6601 19.2106 19.1289 20.7064 17.2305 20.9186C13.7824 21.304 10.2177 21.304 6.76954 20.9186C4.87114 20.7064 3.33995 19.2106 3.11713 17.3056C2.70485 13.7806 2.70485 10.2195 3.11713 6.69452C3.33995 4.78947 4.87114 3.29369 6.76954 3.08151ZM17 6.00005C16.4477 6.00005 16 6.44776 16 7.00005C16 7.55233 16.4477 8.00005 17 8.00005C17.5523 8.00005 18 7.55233 18 7.00005C18 6.44776 17.5523 6.00005 17 6.00005ZM7.25 12C7.25 9.37669 9.37665 7.25005 12 7.25005C14.6234 7.25005 16.75 9.37669 16.75 12C16.75 14.6234 14.6234 16.75 12 16.75C9.37665 16.75 7.25 14.6234 7.25 12Z"
          ></path>
        </svg>Instagram
      </a>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__rule"><div></div></div>
    <div class="footer__legal">
      <div>{t(lang, 'footer.copy_short').replace('{year}', year)}</div>
      <div class="footer__legal-links">
        <a href={legal.notice}>{t(lang, 'footer.legal_notice')}</a>
        <a href={legal.privacy}>{t(lang, 'footer.privacy_long')}</a>
        <a href={legal.cookies}>{t(lang, 'footer.cookies')}</a>
        <a href={legal.terms}>{t(lang, 'footer.terms')}</a>
      </div>
    </div>
  </div>
</footer>

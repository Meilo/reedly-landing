---
import { getLang, t } from '@/lib/i18n';

const lang = getLang(Astro.url.pathname);

const integrations = [
  { src: '/integration/hubspot.png', alt: 'HubSpot' },
  { src: '/integration/salesforce.png', alt: 'Salesforce' },
  { src: '/integration/whatsapp.svg', alt: 'WhatsApp' },
  { src: '/integration/email.svg', alt: 'Email' },
  { src: '/integration/pdf.svg', alt: lang === 'fr' ? 'Export PDF' : 'PDF export' },
  { src: '/integration/slack.png', alt: 'Slack' },
];
---

<section class="section section--white" id="demo">
  <div class="inner">
    <div class="demo__head reveal center-mobile">
      <h2 class="display display--lg" set:html={t(lang, 'demo.title')} />
      <p class="lead">{t(lang, 'demo.lead')}</p>
    </div>

    <div class="demo__grid reveal">
      <div class="frame demo__photo">
        <img
          src="/images/field-rep.webp"
          alt={lang === 'fr' ? 'Commerciale terrain' : 'Field sales rep'}
          width="1122"
          height="1402"
          loading="lazy"
        />
        <div class="frame__scrim" aria-hidden="true"></div>
        <div class="frame__badge">{t(lang, 'demo.label_record')}</div>
      </div>

      <div class="demo__panels">
        <div class="demo__card">
          <span class="demo__chip">{t(lang, 'demo.label_report')}</span>
          <div class="phone" style="width:92%">
            <div class="phone__screen">
              <img
                src="/app/report-light.png"
                alt={lang === 'fr'
                  ? 'Compte rendu structuré généré par Reedly'
                  : 'Structured report generated by Reedly'}
                width="1179"
                height="2556"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <div class="demo__col">
          <div class="demo__integrations">
            <div class="demo__integrations-grid">
              {integrations.map((i) => (
                <img src={i.src} alt={i.alt} width="32" height="32" loading="lazy" />
              ))}
            </div>
          </div>

          <div class="demo__record">
            <div class="phone phone--sm">
              <div class="phone__screen">
                <img
                  src="/app/record-light.png"
                  alt={lang === 'fr'
                    ? "Écran d'enregistrement de l'app Reedly"
                    : 'Reedly app recording screen'}
                  width="1179"
                  height="2556"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

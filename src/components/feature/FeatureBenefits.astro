---
import Icon from '@/components/Icon.astro';

interface Props {
  title: string;
  cards: { title: string; text: string; icon: string }[];
}

const { title, cards } = Astro.props;
---

<section class="section">
  <div class="inner benefits">
    <div class="benefits__head reveal center-mobile">
      <h2 class="display display--lg" set:html={title} />
    </div>

    <ul class="benefits__list reveal">
      {cards.map((card) => (
        <li>
          <span class="benefits__icon"><Icon name={card.icon} size={30} /></span>
          <h3>{card.title}</h3>
          <p set:html={card.text} />
        </li>
      ))}
    </ul>
  </div>
</section>

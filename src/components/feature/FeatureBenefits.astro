---
import Icon from '@/components/Icon.astro';

interface Props {
  title: string;
  cards: { title: string; text: string; icon: string }[];
}

const { title, cards } = Astro.props;
---

<section class="section">
  <div class="inner">
    <div class="reveal center-mobile">
      <h2 class="display display--lg" set:html={title} />
    </div>

    <div class="feature-grid feature-grid--wide reveal">
      {cards.map((card) => (
        <article class="feature-item">
          <span class="feature-item__icon"><Icon name={card.icon} size={60} /></span>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

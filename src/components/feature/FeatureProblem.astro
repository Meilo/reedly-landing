---
import Icon from '@/components/Icon.astro';

interface Props {
  title: string;
  lead: string;
  cards: { title: string; text: string; icon: string }[];
}

const { title, lead, cards } = Astro.props;
---

<section class="section problem">
  <div class="inner problem__inner">
    <div class="reveal center-mobile">
      <h2 class="display display--lg" set:html={title} />
      <p class="lead" set:html={lead} />
    </div>

    <ul class="problem__pile reveal">
      {cards.map((card) => (
        <li>
          <Icon name={card.icon} size={44} />
          <h3>{card.title}</h3>
          <p set:html={card.text} />
        </li>
      ))}
    </ul>
  </div>
</section>

---
import Icon from '@/components/Icon.astro';

interface Props {
  title: string;
  lead: string;
  cards: { title: string; text: string; icon: string }[];
}

const { title, lead, cards } = Astro.props;
---

<section class="section section--white">
  <div class="inner">
    <div class="reveal center-mobile">
      <h2 class="display display--lg" set:html={title} />
      <p class="lead" set:html={lead} />
    </div>

    <div class="feature-grid reveal">
      {cards.map((card) => (
        <article class="feature-item">
          <span class="feature-item__icon"><Icon name={card.icon} size={60} /></span>
          <h3>{card.title}</h3>
          <p set:html={card.text} />
        </article>
      ))}
    </div>
  </div>
</section>

---
interface Props {
  title: string;
  steps: { title: string; text: string }[];
}

const { title, steps } = Astro.props;
---

<section class="section section--dark" data-nav-dark>
  <div class="inner solution__inner">
    <div class="solution__head reveal center-mobile">
      <h2 class="display display--lg" set:html={title} />
    </div>

    <ol class="solution__steps reveal">
      {steps.map((step, i) => (
        <li>
          <span class="solution__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="solution__body">
            <span class="solution__title">{step.title}</span>
            <span class="solution__text">{step.text}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

---
import { t, type Lang } from '@/lib/i18n';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  image: string;
  imageAlt: string;
  lang: Lang;
}

const { eyebrow, title, lead, image, imageAlt, lang } = Astro.props;
const home = `/${lang}`;
---

<section class="fhero">
  <div class="inner fhero__inner">
    <div class="fhero__text reveal center-mobile">
      <h1 class="display display--xl" set:html={title} />
      <p class="lead">{lead}</p>
      <div class="btn-row">
        <a
          class="btn btn--primary"
          href={`${home}#rdv`}
          data-track-id="feature_hero_book_demo"
          data-track-type="demo"
          data-track-section="feature_hero">{t(lang, 'cta.book_demo')}</a
        >
        <a
          class="btn btn--ghost"
          href={`${home}#rdv`}
          data-track-id="feature_hero_try_free"
          data-track-type="trial"
          data-track-section="feature_hero">{t(lang, 'cta.try_free')}</a
        >
      </div>
    </div>

    <div class="fhero__media reveal">
      <div class="frame frame--portrait">
        <img src={image} alt={imageAlt} width="1122" height="1402" fetchpriority="high" />
        <div class="frame__scrim" aria-hidden="true"></div>
        <div class="frame__badge">{eyebrow}</div>
      </div>
    </div>
  </div>
</section>

---
import Icon from '@/components/Icon.astro';
import type { Lang } from '@/lib/i18n';

interface Props {
  features: { slug: string; label: string }[];
  lang: Lang;
}

const { features, lang } = Astro.props;
const heading = lang === 'fr' ? 'À découvrir aussi' : 'Explore next';
---

{features.length > 0 && (
  <section class="section section--white">
    <div class="inner reveal">
      <h2 class="display display--lg center-mobile">{heading}</h2>
      <div class="related">
        {features.map((f) => (
          <a class="related__link" href={`/${lang}/features/${f.slug}`}>
            {f.label}
            <Icon name="arrow-cta" size={16} />
          </a>
        ))}
      </div>
    </div>
  </section>
)}

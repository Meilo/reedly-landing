---
// Book a demo (block 6), qualifying form + calendar embed placeholder.
// Front-only for now: no POST, the submit reveals a calendar placeholder to wire
// to Cal.com / Calendly later.
import { getLang, t } from '@/lib/i18n';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const lang = getLang(path);
---

<!-- ── Book a demo ── -->
<section class="section section--alt" id="rdv">
  <div class="inner">
    <div class="reveal">
      <div class="section__eyebrow">{t(lang, 'bookdemo.eyebrow')}</div>
      <h2 set:html={t(lang, 'bookdemo.title')} />
      <p class="section__lead">{t(lang, 'bookdemo.lead')}</p>
    </div>

    <div class="contact__grid">
      <!-- Left: value / reassurance -->
      <div class="bookdemo__intro reveal">
        <p class="bookdemo__text">{t(lang, 'bookdemo.intro')}</p>
      </div>

      <!-- Right: qualifying form -->
      <div class="contact__form-card reveal">
        <form id="bookdemo-form" novalidate>
          <div class="form__field">
            <label class="form__label" for="bd-role">{t(lang, 'bookdemo.role.label')}</label>
            <select class="form__select" id="bd-role" name="role" required>
              <option value="" disabled selected>{t(lang, 'bookdemo.role.select')}</option>
              <option value="head_of_sales">{t(lang, 'bookdemo.role.director')}</option>
              <option value="founder_ceo">{t(lang, 'bookdemo.role.owner')}</option>
              <option value="sales_rep">{t(lang, 'bookdemo.role.rep')}</option>
              <option value="other">{t(lang, 'bookdemo.role.other')}</option>
            </select>
          </div>

          <div class="form__field">
            <label class="form__label" for="bd-team">{t(lang, 'bookdemo.team.label')}</label>
            <select class="form__select" id="bd-team" name="team_size" required>
              <option value="" disabled selected>{t(lang, 'bookdemo.team.select')}</option>
              <option value="1">{t(lang, 'bookdemo.team.1')}</option>
              <option value="2-5">{t(lang, 'bookdemo.team.2_5')}</option>
              <option value="6-15">{t(lang, 'bookdemo.team.6_15')}</option>
              <option value="16+">{t(lang, 'bookdemo.team.16')}</option>
            </select>
          </div>

          <div class="form__field">
            <label class="form__label" for="bd-sector">{t(lang, 'bookdemo.sector.label')}</label>
            <select class="form__select" id="bd-sector" name="sector">
              <option value="" disabled selected>{t(lang, 'bookdemo.sector.select')}</option>
              <option value="tour_operateur">{t(lang, 'bookdemo.sector.to')}</option>
              <option value="agence_voyages">{t(lang, 'bookdemo.sector.agency')}</option>
              <option value="receptif_dmc">{t(lang, 'bookdemo.sector.dmc')}</option>
              <option value="mice">{t(lang, 'bookdemo.sector.mice')}</option>
              <option value="transport">{t(lang, 'bookdemo.sector.transport')}</option>
              <option value="croisiere">{t(lang, 'bookdemo.sector.cruise')}</option>
              <option value="hotellerie">{t(lang, 'bookdemo.sector.hospitality')}</option>
              <option value="loisirs">{t(lang, 'bookdemo.sector.leisure')}</option>
              <option value="other">{t(lang, 'bookdemo.sector.other')}</option>
            </select>
          </div>

          <div class="form__field">
            <label class="form__label" for="bd-email">{t(lang, 'bookdemo.email.label')}</label>
            <input
              class="form__input"
              type="email"
              id="bd-email"
              name="email"
              placeholder={t(lang, 'bookdemo.email.ph')}
              required
              autocomplete="email"
            />
          </div>

          <button
            class="btn btn--primary form__submit"
            type="submit"
            id="bd-submit"
            data-track-id="bookdemo_submit"
            data-track-type="demo"
            data-track-section="bookdemo"
          >
            {t(lang, 'bookdemo.submit')}
          </button>

          <div class="bookdemo__hint">{t(lang, 'bookdemo.hint')}</div>
        </form>

        <!-- Native booking calendar, revealed after the qualifying step. -->
        <div class="bookdemo__calendar" id="bookdemo-calendar" hidden>
          <button type="button" class="bookdemo__cal-back bookdemo__cal-back--top" id="cal-back-top">{t(lang, 'bookdemo.cal.back_form')}</button>
          <p class="bookdemo__cal-tznote" id="cal-tznote">{t(lang, 'bookdemo.cal.tznote')}</p>

          <div class="bookdemo__cal-status" id="cal-status">{t(lang, 'bookdemo.cal.loading')}</div>

          <div class="bookdemo__cal-grid" id="cal-grid" hidden>
            <div class="bookdemo__cal-col">
              <div class="bookdemo__cal-label">{t(lang, 'bookdemo.cal.pickday')}</div>
              <div class="bookdemo__cal-days" id="cal-days"></div>
            </div>
            <div class="bookdemo__cal-col">
              <div class="bookdemo__cal-label">{t(lang, 'bookdemo.cal.pickslot')}</div>
              <div class="bookdemo__cal-slots" id="cal-slots"></div>
            </div>
          </div>

          <form class="bookdemo__cal-confirm" id="cal-confirm" hidden novalidate>
            <div class="bookdemo__cal-recap" id="cal-recap"></div>
            <input type="text" class="form__input" id="cal-name" name="name" required
              placeholder={t(lang, 'bookdemo.cal.name')} autocomplete="name" />
            <textarea class="form__textarea bookdemo__cal-note" id="cal-note" name="note" rows="3" required
              placeholder={t(lang, 'bookdemo.cal.note')}></textarea>
            <input type="text" id="cal-hp" name="company_website" tabindex="-1" autocomplete="off"
              aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
            <div class="bookdemo__cal-actions">
              <button type="submit" class="btn btn--primary btn--md" id="cal-submit">{t(lang, 'bookdemo.cal.confirm')}</button>
            </div>
            <div class="bookdemo__cal-err" id="cal-confirm-err" hidden></div>
          </form>

          <div class="bookdemo__cal-success" id="cal-success" hidden>
            <div class="bookdemo__cal-success-icon">✓</div>
            <h3>{t(lang, 'bookdemo.cal.success_title')}</h3>
            <p id="cal-success-when"></p>
            <p>{t(lang, 'bookdemo.cal.success_body')}</p>
            <a class="btn btn--primary btn--md" id="cal-meet" href="#" target="_blank" rel="noopener">{t(lang, 'bookdemo.cal.meet')}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bookdemo__intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .bookdemo__text {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 18px;
  }
  /* lift the global 22ch cap so "ce que vos agences vous disent vraiment."
     stays on one line (wraps only on small phones) */
  #rdv h2 { max-width: none; }
  .bookdemo__hint {
    text-align: center;
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 12px;
  }
  .bookdemo__calendar {
    margin-top: 20px;
  }
  /* Ensure the [hidden] attribute wins over the explicit display rules below. */
  .bookdemo__calendar [hidden] { display: none !important; }
  .bookdemo__cal-back--top { display: inline-block; margin-bottom: 8px; }
  .bookdemo__cal-tznote { font-size: 0.78rem; color: var(--muted); margin: 0 0 14px; }
  .bookdemo__cal-status { padding: 28px; text-align: center; color: var(--muted); font-family: var(--mono); font-size: 0.85rem; }
  .bookdemo__cal-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 18px; }
  @media (max-width: 640px) { .bookdemo__cal-grid { grid-template-columns: 1fr; } }
  .bookdemo__cal-label { font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 10px; }
  .bookdemo__cal-days { display: flex; flex-direction: column; gap: 6px; max-height: 320px; overflow-y: auto; padding-right: 4px; }
  .bookdemo__cal-slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(78px, 1fr)); gap: 8px; align-content: start; max-height: 320px; overflow-y: auto; padding-right: 4px; }
  /* Day/slot buttons are created in JS, so they miss Astro's scope attribute.
     Anchor to the scoped container and target the dynamic children with :global(). */
  .bookdemo__calendar :global(.bookdemo__cal-day),
  .bookdemo__calendar :global(.bookdemo__cal-slot) {
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.025);
    color: var(--text);
    font-size: 0.9rem;
    font-family: var(--sans);
    cursor: pointer;
    text-align: center;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease, transform 0.1s ease;
  }
  .bookdemo__calendar :global(.bookdemo__cal-day) { text-align: left; }
  .bookdemo__calendar :global(.bookdemo__cal-slot) {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--green);
  }
  .bookdemo__calendar :global(.bookdemo__cal-day):hover,
  .bookdemo__calendar :global(.bookdemo__cal-slot):hover {
    border-color: var(--green);
    background: rgba(34, 197, 94, 0.1);
    color: var(--text);
  }
  .bookdemo__calendar :global(.bookdemo__cal-slot):hover { color: var(--green); }
  .bookdemo__calendar :global(.bookdemo__cal-day):active,
  .bookdemo__calendar :global(.bookdemo__cal-slot):active { transform: translateY(1px); }
  .bookdemo__calendar :global(.bookdemo__cal-day):focus-visible,
  .bookdemo__calendar :global(.bookdemo__cal-slot):focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .bookdemo__calendar :global(.bookdemo__cal-day[aria-selected="true"]) {
    border-color: var(--green);
    background: rgba(34, 197, 94, 0.14);
    color: var(--text);
    font-weight: 600;
  }
  .bookdemo__cal-days::-webkit-scrollbar, .bookdemo__cal-slots::-webkit-scrollbar { width: 6px; }
  .bookdemo__cal-days::-webkit-scrollbar-thumb, .bookdemo__cal-slots::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
  .bookdemo__cal-confirm { display: flex; flex-direction: column; gap: 12px; }
  .bookdemo__cal-note { min-height: 78px; }
  .bookdemo__cal-recap { font-size: 1.05rem; color: var(--text); font-weight: 600; }
  .bookdemo__cal-recap::first-letter { text-transform: uppercase; }
  .bookdemo__cal-actions { display: flex; gap: 12px; justify-content: flex-end; align-items: center; flex-wrap: wrap; margin-top: 4px; }
  .bookdemo__cal-back { background: none; border: none; padding: 6px 2px; color: var(--muted); font-size: 0.88rem; font-family: var(--sans); cursor: pointer; transition: color 0.15s ease; }
  .bookdemo__cal-back:hover { color: var(--text); }
  .bookdemo__cal-back:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; border-radius: 4px; }
  .bookdemo__cal-err { color: var(--red); font-size: 0.85rem; }
  .bookdemo__cal-success { text-align: center; padding: 20px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .bookdemo__cal-success-icon { width: 44px; height: 44px; border-radius: 50%; background: rgba(34,197,94,0.15); color: var(--green); display: grid; place-items: center; font-size: 1.4rem; }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById("bookdemo-form");
    var calendar = document.getElementById("bookdemo-calendar");
    if (!form || !calendar) return;

    var lang = location.pathname.indexOf("/en") === 0 ? "en" : "fr";
    var locale = lang === "fr" ? "fr-FR" : "en-US";
    function tr(key) {
      try { return (window._reedlyT && window._reedlyT[lang] && window._reedlyT[lang][key]) || key; }
      catch (e) { return key; }
    }

    var statusEl = document.getElementById("cal-status");
    var gridEl = document.getElementById("cal-grid");
    var daysEl = document.getElementById("cal-days");
    var slotsEl = document.getElementById("cal-slots");
    var confirmEl = document.getElementById("cal-confirm");
    var recapEl = document.getElementById("cal-recap");
    var successEl = document.getElementById("cal-success");
    var confirmErr = document.getElementById("cal-confirm-err");
    var backTopEl = document.getElementById("cal-back-top");
    var tznoteEl = document.getElementById("cal-tznote");
    var backMode = "form";
    var selectedSlot = null;

    function show(el) { el.removeAttribute("hidden"); }
    function hide(el) { el.setAttribute("hidden", ""); }

    // One top-of-panel back control whose label + action adapt to the step.
    function setBack(mode) {
      backMode = mode;
      backTopEl.textContent = tr(mode === "grid" ? "bookdemo.cal.back" : "bookdemo.cal.back_form");
      show(backTopEl);
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      if (!form.reportValidity()) return;
      hide(form);
      show(calendar);
      setBack("form");
      show(tznoteEl);
      calendar.scrollIntoView({ behavior: "smooth", block: "nearest" });
      loadAvailability();
      try {
        if (typeof window.reedlyTrackEvent === "function") {
          window.reedlyTrackEvent("landing_bookdemo_qualified", {
            role: (document.getElementById("bd-role") || {}).value || "",
            team_size: (document.getElementById("bd-team") || {}).value || "",
          });
        }
      } catch (err) {}
    });

    function loadAvailability() {
      show(statusEl); statusEl.textContent = tr("bookdemo.cal.loading");
      hide(gridEl); hide(confirmEl); hide(successEl);
      fetch("/api/availability")
        .then(function (r) { if (!r.ok) throw new Error("http"); return r.json(); })
        .then(function (data) {
          if (!data.days || data.days.length === 0) {
            statusEl.textContent = tr("bookdemo.cal.empty");
            return;
          }
          hide(statusEl); show(gridEl);
          renderDays(data.days);
        })
        .catch(function () { statusEl.textContent = tr("bookdemo.cal.error"); });
    }

    function renderDays(days) {
      daysEl.innerHTML = ""; slotsEl.innerHTML = "";
      var dayFmt = new Intl.DateTimeFormat(locale, { weekday: "long", day: "numeric", month: "long" });
      days.forEach(function (day, i) {
        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "bookdemo__cal-day";
        btn.textContent = dayFmt.format(new Date(day.slots[0]));
        btn.setAttribute("aria-selected", i === 0 ? "true" : "false");
        btn.addEventListener("click", function () {
          Array.prototype.forEach.call(daysEl.children, function (c) { c.setAttribute("aria-selected", "false"); });
          btn.setAttribute("aria-selected", "true");
          renderSlots(day.slots);
        });
        daysEl.appendChild(btn);
      });
      renderSlots(days[0].slots);
    }

    function renderSlots(slots) {
      slotsEl.innerHTML = "";
      var timeFmt = new Intl.DateTimeFormat(locale, { hour: "2-digit", minute: "2-digit" });
      slots.forEach(function (iso) {
        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "bookdemo__cal-slot";
        btn.textContent = timeFmt.format(new Date(iso));
        btn.addEventListener("click", function () { openConfirm(iso); });
        slotsEl.appendChild(btn);
      });
    }

    function openConfirm(iso) {
      selectedSlot = iso;
      var fmt = new Intl.DateTimeFormat(locale, {
        weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit",
      });
      recapEl.textContent = fmt.format(new Date(iso));
      hide(confirmErr); confirmErr.textContent = "";
      hide(gridEl); hide(tznoteEl); setBack("grid"); show(confirmEl);
      var emailField = document.getElementById("bd-email");
      confirmEl.dataset.email = emailField ? emailField.value : "";
    }

    backTopEl.addEventListener("click", function () {
      if (backMode === "grid") {
        hide(confirmEl); show(tznoteEl); show(gridEl); setBack("form");
      } else {
        hide(calendar); show(form);
        form.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    });

    confirmEl.addEventListener("submit", function (e) {
      e.preventDefault();
      if (!confirmEl.reportValidity()) return;
      var submitBtn = document.getElementById("cal-submit");
      var name = document.getElementById("cal-name").value.trim();
      submitBtn.disabled = true; submitBtn.textContent = tr("bookdemo.cal.booking");
      hide(confirmErr);

      fetch("/api/book", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          start: selectedSlot,
          email: confirmEl.dataset.email || "",
          name: name,
          note: document.getElementById("cal-note").value.trim(),
          company_website: document.getElementById("cal-hp").value,
          role: (document.getElementById("bd-role") || {}).value || "",
          team_size: (document.getElementById("bd-team") || {}).value || "",
          sector: (document.getElementById("bd-sector") || {}).value || "",
        }),
      })
        .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, status: r.status, body: b }; }); })
        .then(function (res) {
          submitBtn.disabled = false; submitBtn.textContent = tr("bookdemo.cal.confirm");
          if (res.ok) {
            showSuccess(res.body);
          } else if (res.status === 409) {
            show(confirmErr); confirmErr.textContent = tr("bookdemo.cal.slot_taken");
            hide(confirmEl); show(tznoteEl); show(gridEl); setBack("form"); loadAvailability();
          } else {
            show(confirmErr); confirmErr.textContent = tr("bookdemo.cal.error");
          }
        })
        .catch(function () {
          submitBtn.disabled = false; submitBtn.textContent = tr("bookdemo.cal.confirm");
          show(confirmErr); confirmErr.textContent = tr("bookdemo.cal.error");
        });
    });

    function showSuccess(body) {
      hide(confirmEl); hide(gridEl); hide(statusEl); hide(tznoteEl); hide(backTopEl); show(successEl);
      var fmt = new Intl.DateTimeFormat(locale, {
        weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit",
      });
      document.getElementById("cal-success-when").textContent = fmt.format(new Date(body.start));
      var meet = document.getElementById("cal-meet");
      if (body.meetLink) { meet.href = body.meetLink; show(meet); } else { hide(meet); }
      try {
        if (typeof window.reedlyTrackEvent === "function") {
          window.reedlyTrackEvent("landing_bookdemo_booked", { start: body.start });
        }
      } catch (err) {}
    }
  })();
</script>

---
import Icon from '@/components/Icon.astro';
// Book a demo: qualifying form, then the native slot picker.
// Availability comes from /api/availability (Google FreeBusy minus booked
// slots); /api/book creates the Meet event. The inline script below reads its
// UI strings from the JSON island so it never needs a second dictionary.
import { getLang, t } from '@/lib/i18n';

const lang = getLang(Astro.url.pathname);

const roles = [
  ['head_of_sales', 'bookdemo.role.director'],
  ['founder_ceo', 'bookdemo.role.owner'],
  ['sales_rep', 'bookdemo.role.rep'],
  ['other', 'bookdemo.role.other'],
] as const;

const sectors = [
  ['tour_operateur', 'bookdemo.sector.to'],
  ['agence_voyages', 'bookdemo.sector.agency'],
  ['receptif_dmc', 'bookdemo.sector.dmc'],
  ['mice', 'bookdemo.sector.mice'],
  ['transport', 'bookdemo.sector.transport'],
  ['croisiere', 'bookdemo.sector.cruise'],
  ['hotellerie', 'bookdemo.sector.hospitality'],
  ['loisirs', 'bookdemo.sector.leisure'],
  ['other', 'bookdemo.sector.other'],
] as const;

const teamSizes = [
  { value: '1', label: '1' },
  { value: '2-5', label: '2 à 5' },
  { value: '6-15', label: '6 à 15' },
  { value: '16+', label: '16+' },
] as const;

const strings = {
  loading: t(lang, 'bookdemo.cal.loading'),
  empty: t(lang, 'bookdemo.cal.empty'),
  error: t(lang, 'bookdemo.cal.error'),
  slot_taken: t(lang, 'bookdemo.cal.slot_taken'),
  booking: t(lang, 'bookdemo.cal.booking'),
  confirm: t(lang, 'bookdemo.cal.confirm'),
  back: t(lang, 'bookdemo.cal.back'),
  back_form: t(lang, 'bookdemo.cal.back_form'),
  pickday: t(lang, 'bookdemo.cal.pickday'),
  pickslot: t(lang, 'bookdemo.cal.pickslot'),
};
---

<section class="section section--white" id="rdv">
  <div class="inner book__inner">
    <div class="book__head reveal center-mobile">
      <h2 class="display display--lg" set:html={t(lang, 'bookdemo.title')} />
      <p class="lead">{t(lang, 'bookdemo.lead')}</p>
    </div>

    <div class="book__card reveal">
      <form id="bookdemo-form" novalidate>
        <div class="book__row">
          <label class="book__label" for="bd-email">{t(lang, 'bookdemo.email.label')}</label>
          <div class="book__field">
            <input
              type="email"
              id="bd-email"
              name="email"
              placeholder={t(lang, 'bookdemo.email.ph')}
              required
              autocomplete="email"
            />
          </div>
        </div>

        <div class="book__row book__row--role">
          <label class="book__label" for="bd-role">{t(lang, 'bookdemo.role.label')}</label>
          <div class="book__field">
            <select id="bd-role" name="role" required>
              <option value="" disabled selected>{t(lang, 'bookdemo.role.select')}</option>
              {roles.map(([value, key]) => <option value={value}>{t(lang, key)}</option>)}
            </select>
            <span class="book__chevron"><Icon name="chevron-down" size={14} /></span>
          </div>
        </div>

        <div class="book__row">
          <label class="book__label" for="bd-sector">{t(lang, 'bookdemo.sector.label')}</label>
          <div class="book__field">
            <select id="bd-sector" name="sector">
              <option value="" disabled selected>{t(lang, 'bookdemo.sector.select')}</option>
              {sectors.map(([value, key]) => <option value={value}>{t(lang, key)}</option>)}
            </select>
            <span class="book__chevron"><Icon name="chevron-down" size={14} /></span>
          </div>
        </div>

        <div class="book__row book__row--team">
          <span class="book__label" id="bd-team-label">{t(lang, 'bookdemo.team.label')}</span>
          <div class="book__chips" role="group" aria-labelledby="bd-team-label">
            {teamSizes.map((size) => (
              <button class="book__chip" type="button" data-size={size.value}>{size.label}</button>
            ))}
          </div>
          <input type="hidden" id="bd-team" name="team_size" required />
        </div>

        <div class="book__submit">
          <button
            class="btn btn--ink btn--block"
            type="submit"
            data-track-id="bookdemo_submit"
            data-track-type="demo"
            data-track-section="bookdemo"
          >
            {t(lang, 'bookdemo.submit')}
            <Icon name="arrow-cta" size={16} />
          </button>
        </div>
      </form>

      <!-- Native slot picker, revealed after the qualifying step. -->
      <div class="book__slots" id="bookdemo-calendar" hidden>
        <button type="button" class="back-link" id="cal-back-top">{t(lang, 'bookdemo.cal.back_form')}</button>
        <p class="book__feedback" id="cal-tznote">{t(lang, 'bookdemo.cal.tznote')}</p>
        <p class="book__feedback" id="cal-status">{t(lang, 'bookdemo.cal.loading')}</p>

        <div id="cal-grid" hidden>
          <div class="book__days" id="cal-days"></div>
          <div class="book__times" id="cal-slots"></div>
        </div>

        <form id="cal-confirm" hidden novalidate>
          <p class="book__recap" id="cal-recap"></p>
          <div class="book__row">
            <label class="book__label" for="cal-name">{t(lang, 'bookdemo.cal.name')}</label>
            <div class="book__field">
              <input type="text" id="cal-name" name="name" required autocomplete="name" />
            </div>
          </div>
          <div class="book__row">
            <label class="book__label" for="cal-note">{t(lang, 'bookdemo.cal.note')}</label>
            <div class="book__field">
              <input type="text" id="cal-note" name="note" required />
            </div>
          </div>
          <input
            type="text"
            id="cal-hp"
            name="company_website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0"
          />
          <div class="book__submit">
            <button class="btn btn--primary btn--block" type="submit" id="cal-submit"
              >{t(lang, 'bookdemo.cal.confirm')}</button
            >
            <p class="book__feedback book__feedback--error" id="cal-confirm-err" hidden></p>
          </div>
        </form>

        <div id="cal-success" hidden>
          <p class="book__recap">{t(lang, 'bookdemo.cal.success_title')}</p>
          <p class="book__feedback" id="cal-success-when"></p>
          <p class="book__feedback">{t(lang, 'bookdemo.cal.success_body')}</p>
          <a class="btn btn--primary" id="cal-meet" href="#" target="_blank" rel="noopener"
            >{t(lang, 'bookdemo.cal.meet')}</a
          >
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="bd-i18n" is:inline set:html={JSON.stringify(strings)} />

<style>
  .book__chevron {
    position: absolute;
    right: 0;
    pointer-events: none;
    color: var(--faint);
  }
  .book__recap {
    margin: 22px 0 0;
    padding: 0 clamp(18px, 4vw, 32px);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .book__recap::first-letter {
    text-transform: uppercase;
  }
  #cal-success {
    padding-bottom: 8px;
    text-align: center;
  }
  #bookdemo-calendar[hidden],
  #bookdemo-calendar [hidden] {
    display: none !important;
  }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('bookdemo-form');
    var calendar = document.getElementById('bookdemo-calendar');
    if (!form || !calendar) return;

    var lang = location.pathname.indexOf('/en') === 0 ? 'en' : 'fr';
    var locale = lang === 'fr' ? 'fr-FR' : 'en-US';
    var S = {};
    try {
      S = JSON.parse(document.getElementById('bd-i18n').textContent);
    } catch (e) {}
    function tr(key) {
      return S[key] || key;
    }

    var statusEl = document.getElementById('cal-status');
    var gridEl = document.getElementById('cal-grid');
    var daysEl = document.getElementById('cal-days');
    var slotsEl = document.getElementById('cal-slots');
    var confirmEl = document.getElementById('cal-confirm');
    var recapEl = document.getElementById('cal-recap');
    var successEl = document.getElementById('cal-success');
    var confirmErr = document.getElementById('cal-confirm-err');
    var backTopEl = document.getElementById('cal-back-top');
    var tznoteEl = document.getElementById('cal-tznote');
    var teamInput = document.getElementById('bd-team');
    var backMode = 'form';
    var selectedSlot = null;

    function show(el) { el.removeAttribute('hidden'); }
    function hide(el) { el.setAttribute('hidden', ''); }

    // Team size is a chip group, so it feeds the hidden input the form validates.
    form.querySelectorAll('.book__chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        form.querySelectorAll('.book__chip').forEach(function (c) {
          c.classList.remove('is-active');
        });
        chip.classList.add('is-active');
        teamInput.value = chip.dataset.size;
      });
    });

    // One top-of-panel back control whose label + action adapt to the step.
    function setBack(mode) {
      backMode = mode;
      backTopEl.textContent = tr(mode === 'grid' ? 'back' : 'back_form');
      show(backTopEl);
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.reportValidity()) return;
      hide(form);
      show(calendar);
      setBack('form');
      show(tznoteEl);
      calendar.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      loadAvailability();
      try {
        if (typeof window.reedlyTrackEvent === 'function') {
          window.reedlyTrackEvent('landing_bookdemo_qualified', {
            role: (document.getElementById('bd-role') || {}).value || '',
            team_size: teamInput.value || '',
          });
        }
      } catch (err) {}
    });

    function loadAvailability() {
      show(statusEl);
      statusEl.textContent = tr('loading');
      hide(gridEl);
      hide(confirmEl);
      hide(successEl);
      fetch('/api/availability')
        .then(function (r) {
          if (!r.ok) throw new Error('http');
          return r.json();
        })
        .then(function (data) {
          if (!data.days || data.days.length === 0) {
            statusEl.textContent = tr('empty');
            return;
          }
          hide(statusEl);
          show(gridEl);
          renderDays(data.days);
        })
        .catch(function () {
          statusEl.textContent = tr('error');
        });
    }

    function renderDays(days) {
      daysEl.innerHTML = '';
      slotsEl.innerHTML = '';
      var dayFmt = new Intl.DateTimeFormat(locale, { weekday: 'short', day: 'numeric', month: 'short' });
      days.forEach(function (day, i) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'book__day' + (i === 0 ? ' is-active' : '');
        btn.textContent = dayFmt.format(new Date(day.slots[0]));
        btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        btn.addEventListener('click', function () {
          Array.prototype.forEach.call(daysEl.children, function (c) {
            c.setAttribute('aria-selected', 'false');
            c.classList.remove('is-active');
          });
          btn.setAttribute('aria-selected', 'true');
          btn.classList.add('is-active');
          renderSlots(day.slots);
        });
        daysEl.appendChild(btn);
      });
      renderSlots(days[0].slots);
    }

    function renderSlots(slots) {
      slotsEl.innerHTML = '';
      var timeFmt = new Intl.DateTimeFormat(locale, { hour: '2-digit', minute: '2-digit' });
      slots.forEach(function (iso) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'book__time';
        btn.textContent = timeFmt.format(new Date(iso));
        btn.addEventListener('click', function () {
          openConfirm(iso);
        });
        slotsEl.appendChild(btn);
      });
    }

    function openConfirm(iso) {
      selectedSlot = iso;
      var fmt = new Intl.DateTimeFormat(locale, {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        hour: '2-digit',
        minute: '2-digit',
      });
      recapEl.textContent = fmt.format(new Date(iso));
      hide(confirmErr);
      confirmErr.textContent = '';
      hide(gridEl);
      hide(tznoteEl);
      setBack('grid');
      show(confirmEl);
      var emailField = document.getElementById('bd-email');
      confirmEl.dataset.email = emailField ? emailField.value : '';
    }

    backTopEl.addEventListener('click', function () {
      if (backMode === 'grid') {
        hide(confirmEl);
        show(tznoteEl);
        show(gridEl);
        setBack('form');
      } else {
        hide(calendar);
        show(form);
        form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    confirmEl.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!confirmEl.reportValidity()) return;
      var submitBtn = document.getElementById('cal-submit');
      var name = document.getElementById('cal-name').value.trim();
      submitBtn.disabled = true;
      submitBtn.textContent = tr('booking');
      hide(confirmErr);

      fetch('/api/book', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          start: selectedSlot,
          email: confirmEl.dataset.email || '',
          name: name,
          note: document.getElementById('cal-note').value.trim(),
          company_website: document.getElementById('cal-hp').value,
          role: (document.getElementById('bd-role') || {}).value || '',
          team_size: teamInput.value || '',
          sector: (document.getElementById('bd-sector') || {}).value || '',
        }),
      })
        .then(function (r) {
          return r.json().then(function (b) {
            return { ok: r.ok, status: r.status, body: b };
          });
        })
        .then(function (res) {
          submitBtn.disabled = false;
          submitBtn.textContent = tr('confirm');
          if (res.ok) {
            showSuccess(res.body);
          } else if (res.status === 409) {
            show(confirmErr);
            confirmErr.textContent = tr('slot_taken');
            hide(confirmEl);
            show(tznoteEl);
            show(gridEl);
            setBack('form');
            loadAvailability();
          } else {
            show(confirmErr);
            confirmErr.textContent = tr('error');
          }
        })
        .catch(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = tr('confirm');
          show(confirmErr);
          confirmErr.textContent = tr('error');
        });
    });

    function showSuccess(body) {
      hide(confirmEl);
      hide(gridEl);
      hide(statusEl);
      hide(tznoteEl);
      hide(backTopEl);
      show(successEl);
      var fmt = new Intl.DateTimeFormat(locale, {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        hour: '2-digit',
        minute: '2-digit',
      });
      document.getElementById('cal-success-when').textContent = fmt.format(new Date(body.start));
      var meet = document.getElementById('cal-meet');
      if (body.meetLink) {
        meet.href = body.meetLink;
        show(meet);
      } else {
        hide(meet);
      }
      try {
        if (typeof window.reedlyTrackEvent === 'function') {
          window.reedlyTrackEvent('landing_bookdemo_booked', { start: body.start });
        }
      } catch (err) {}
    }
  })();
</script>

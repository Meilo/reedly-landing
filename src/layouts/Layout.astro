---
import '@/styles/global.css';
import PostHog from '@/components/PostHog.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'fr' | 'en';
  ogType?: 'website' | 'article';
  hreflang?: { fr: string; en: string };
  articleMeta?: { publishedTime: string; author: string };
}

const {
  title = 'Reedly · La 1ère intelligence terrain du tourisme',
  description =
    "De chaque rendez-vous client, Reedly fait remonter besoins, engagements, opportunités et risques dans des rapports structurés et un Hub centralisé pour toute l'équipe. Essai gratuit.",
  lang = 'fr',
  ogType = 'website',
  hreflang,
  articleMeta,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = new URL(pathname, 'https://www.reedly.ai');
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';
const ogLocaleAlt = lang === 'fr' ? 'en_US' : 'fr_FR';

// Organization/WebSite only make sense once per site: homepages only.
// SoftwareApplication (with the real, single "Team" offer) also runs on the
// pricing pages. FAQPage is emitted by the page/component that actually
// renders the FAQ (Faq.astro for home/pricing, feature pages for their own),
// never here, so a page never carries more than one.
const isHomePage = pathname === '/' || pathname === '/fr' || pathname === '/en';
const isPricingPage = pathname === '/fr/tarifs' || pathname === '/en/pricing';

const graph: Record<string, unknown>[] = [];

if (isHomePage) {
  graph.push({
    '@type': 'Organization',
    name: 'Reedly',
    url: 'https://www.reedly.ai',
    logo: 'https://www.reedly.ai/favicon.png',
    sameAs: [
      'https://www.linkedin.com/company/reedly/',
      'https://www.instagram.com/reedly.ai/',
      'https://apps.apple.com/fr/app/reedly-rapport-g%C3%A9n%C3%A9r%C3%A9-par-ia/id6760261826',
      'https://play.google.com/store/apps/details?id=com.reedly.app',
      'https://github.com/reedlyio',
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'contact@reedly.ai',
      contactType: 'customer service',
    },
  });
  graph.push({
    '@type': 'WebSite',
    name: 'Reedly',
    url: 'https://www.reedly.ai',
    alternateName: ['Reedly AI', 'reedly.ai'],
  });
}

if (isHomePage || isPricingPage) {
  graph.push({
    '@type': 'SoftwareApplication',
    name: 'Reedly',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'iOS, Android',
    description:
      lang === 'fr'
        ? "L'agent IA qui transforme vos rendez-vous terrain en rapports structurés en moins de 2 minutes."
        : 'The AI agent that turns your field meetings into structured reports in under 2 minutes.',
    url: 'https://www.reedly.ai',
    offers: {
      '@type': 'Offer',
      name: lang === 'fr' ? 'Équipe' : 'Team',
      priceCurrency: 'EUR',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '49',
        priceCurrency: 'EUR',
        unitText: lang === 'fr' ? 'par commercial par mois' : 'per rep per month',
      },
    },
  });
}
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function(){
        var s=localStorage.getItem('theme')||'dark';
        var d=s==='system'?(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'):s;
        document.documentElement.setAttribute('data-theme',d);
        document.documentElement.setAttribute('data-theme-setting',s);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content="https://www.reedly.ai/og-image.png" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:site_name" content="Reedly" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.reedly.ai/og-image.png" />

    {hreflang && (
      <>
        <link rel="alternate" hreflang="fr" href={`https://www.reedly.ai${hreflang.fr}`} />
        <link rel="alternate" hreflang="en" href={`https://www.reedly.ai${hreflang.en}`} />
        <link rel="alternate" hreflang="x-default" href={`https://www.reedly.ai${hreflang.en}`} />
      </>
    )}

    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        <meta property="article:author" content={articleMeta.author} />
      </>
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Schema.org JSON-LD -->
    {graph.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': graph,
      })} />
    )}

    <PostHog />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

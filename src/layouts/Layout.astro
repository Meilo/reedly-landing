---
import '@/styles/global.css';
import PostHog from '@/components/PostHog.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'fr' | 'en';
  ogType?: 'website' | 'article';
  hreflang?: { fr: string; en: string };
  /** Play the intro curtain. Home pages only, once per session. */
  intro?: boolean;
  /** Keep the page out of the index and drop its canonical (the 404). */
  noindex?: boolean;
}

const {
  title = 'Reedly · Les conversations de vos commerciaux terrain en données fiables avec un agent IA',
  description =
    "De chaque rendez-vous client, Reedly fait remonter besoins, engagements, opportunités et risques dans un compte rendu structuré. Essai gratuit.",
  lang = 'fr',
  ogType = 'website',
  hreflang,
  intro = false,
  noindex = false,
} = Astro.props;

// Runs before the first paint so the curtain never flashes where it should
// not appear, and only once per session.
const INTRO_SCRIPT = `(function(){try{if(sessionStorage.getItem('reedly-intro'))return;sessionStorage.setItem('reedly-intro','1')}catch(e){}document.documentElement.classList.add('has-intro')})();`;

// Marks the document as JS-capable so global.css may hide the .reveal blocks,
// then takes the mark back off if main.js has not reported in. Without this a
// browser with JS off, or one where main.js 404s or throws, renders a blank
// page: nearly all the copy lives inside a .reveal. Runs before the first
// paint, so the blocks are never briefly visible before being hidden.
const REVEAL_GATE = `(function(){var d=document.documentElement;d.classList.add('js');setTimeout(function(){if(!window.__reedlyReveal)d.classList.remove('js')},3000)})();`;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = new URL(pathname, 'https://www.reedly.ai');
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';
const ogLocaleAlt = lang === 'fr' ? 'en_US' : 'fr_FR';

// Organization/WebSite only make sense once per site: homepages only.
// SoftwareApplication (with the real, single "Team" offer) rides along, since
// pricing now lives in the home's #pricing section. FAQPage is emitted by the
// component that actually renders the FAQ (Faq.astro for the home, feature
// pages for their own), never here, so a page never carries more than one.
const isHomePage = pathname === '/' || pathname === '/fr' || pathname === '/en';

const graph: Record<string, unknown>[] = [];

if (isHomePage) {
  graph.push({
    '@type': 'Organization',
    name: 'Reedly',
    url: 'https://www.reedly.ai',
    logo: 'https://www.reedly.ai/logo-512.png',
    sameAs: [
      'https://www.linkedin.com/company/reedly/',
      'https://www.instagram.com/reedly.ai/',
      'https://apps.apple.com/fr/app/reedly-compte-rendu-client-ia/id6760261826',
      'https://play.google.com/store/apps/details?id=com.reedly.app',
      'https://github.com/reedlyio',
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'contact@reedly.ai',
      contactType: 'customer service',
    },
  });
  graph.push({
    '@type': 'WebSite',
    name: 'Reedly',
    url: 'https://www.reedly.ai',
    alternateName: ['Reedly AI', 'reedly.ai'],
  });
  graph.push({
    '@type': 'SoftwareApplication',
    name: 'Reedly',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'iOS, Android',
    description:
      lang === 'fr'
        ? "L'agent IA qui transforme vos rendez-vous terrain en rapports structurés en moins de 2 minutes."
        : 'The AI agent that turns your field meetings into structured reports in under 2 minutes.',
    url: 'https://www.reedly.ai',
    offers: {
      '@type': 'Offer',
      name: lang === 'fr' ? 'Équipe' : 'Team',
      priceCurrency: 'EUR',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: '49',
        priceCurrency: 'EUR',
        unitText: lang === 'fr' ? 'par commercial par mois' : 'per rep per month',
      },
    },
  });
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <script is:inline set:html={REVEAL_GATE} />
    {intro && <script is:inline set:html={INTRO_SCRIPT} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    {!noindex && <link rel="canonical" href={canonicalURL.href} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content="https://www.reedly.ai/og-image.png" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:site_name" content="Reedly" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.reedly.ai/og-image.png" />

    {hreflang && (
      <>
        <link rel="alternate" hreflang="fr" href={`https://www.reedly.ai${hreflang.fr}`} />
        <link rel="alternate" hreflang="en" href={`https://www.reedly.ai${hreflang.en}`} />
        <link rel="alternate" hreflang="x-default" href={`https://www.reedly.ai${hreflang.en}`} />
      </>
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@200..800&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="/fonts/Lanterosy.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Schema.org JSON-LD -->
    {graph.length > 0 && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': graph,
      })} />
    )}

    <PostHog />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

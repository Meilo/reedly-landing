---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import FeatureHero from '@/components/feature/FeatureHero.astro';
import FeatureProblem from '@/components/feature/FeatureProblem.astro';
import FeatureSolution from '@/components/feature/FeatureSolution.astro';
import FeatureBenefits from '@/components/feature/FeatureBenefits.astro';
import FeatureUseCases from '@/components/feature/FeatureUseCases.astro';
import FeatureRoles from '@/components/feature/FeatureRoles.astro';
import FeatureFaq from '@/components/feature/FeatureFaq.astro';
import FeatureStickyCta from '@/components/feature/FeatureStickyCta.astro';
import FinalCta from '@/components/FinalCta.astro';
import Footer from '@/components/Footer.astro';
import { getAllFeatureSlugs, loadFeatureContent, findMirrorSlug, findFeatureId } from '@/lib/load-features';
import { heroImage, useCaseImages } from '@/lib/feature-media';

export function getStaticPaths() {
  return getAllFeatureSlugs('en').map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const data = loadFeatureContent('en', slug!);
const mirrorSlug = findMirrorSlug('en', slug!);
const featureId = findFeatureId('en', slug!);

const paths = { fr: `/fr/features/${mirrorSlug}`, en: `/en/features/${slug}` };
const hero = heroImage(featureId, 'en');

const breadcrumbLD = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.reedly.ai/en' },
    { '@type': 'ListItem', position: 2, name: data.hero.sticky },
  ],
};

const faqLD = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout title={data.seo.title} description={data.seo.description} lang="en" hreflang={paths}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(faqLD)} />

  <Nav altHref={paths.fr} />

  <main>
    <FeatureHero
      badge={data.hero.badge}
      title={data.hero.title}
      lead={data.hero.lead}
      image={hero.src}
      imageAlt={hero.alt}
      objectPosition={hero.objectPosition}
      lang="en"
    />
    <FeatureProblem title={data.problem.title} lead={data.problem.lead} cards={data.problem.cards} />
    {data.solution && <FeatureSolution title={data.solution.title} steps={data.solution.steps} />}
    <FeatureBenefits title={data.benefits.title} cards={data.benefits.cards} />
    {data.use_cases?.variant === 'roles' ? (
      <FeatureRoles
        title={data.use_cases.title}
        image={hero.src}
        imageAlt={hero.alt}
        roles={data.use_cases.cards}
        prevLabel="Previous role"
        nextLabel="Next role"
      />
    ) : data.use_cases ? (
      <FeatureUseCases
        title={data.use_cases.title}
        cards={data.use_cases.cards}
        images={useCaseImages('en')}
      />
    ) : null}
    <FeatureFaq faq={data.faq} lang="en" />
    <FinalCta />
  </main>

  <FeatureStickyCta label={data.hero.sticky} lang="en" />

  <Footer />

  <script src="/main.js" is:inline></script>
</Layout>

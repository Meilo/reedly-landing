---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import LegalPage from '@/components/LegalPage.astro';
import Footer from '@/components/Footer.astro';

const sections = [
  {
    id: 'introduction',
    title: 'Introduction',
    paragraphs: [
      'Reedly ("we", "our", or "us") operates the Reedly mobile application (the "App"). This Privacy Policy explains how we collect, use, and protect your information when you use our App.',
      'Reedly is a meeting recording and report generation tool designed for business professionals. By using the App, you agree to the collection and use of information in accordance with this policy.',
    ],
  },
  {
    id: 'informations-collectees',
    title: 'Information we collect',
    paragraphs: [
      '<b>Account information</b>: when you create an account, we collect your email address, username, and optionally your first and last name.',
      '<b>Profile data</b>: any information you choose to add to your profile, including your name and avatar.',
      '<b>Audio recordings</b>: when you use the recording feature, audio is temporarily processed to generate transcripts and structured reports. Audio files are sent to Mistral for transcription.',
      '<b>Generated content</b>: reports and syntheses created from your recordings are stored in your account.',
      '<b>Usage data</b>: we collect anonymous usage data (screens visited, features used) to improve the App via PostHog.',
      '<b>Device information</b>: device type, operating system version, and app version.',
    ],
  },
  {
    id: 'non-collectees',
    title: 'Information we do not collect',
    list: [
      'We do not collect precise location data.',
      'We do not access your contacts, calendar, or other personal data.',
      'We do not sell your personal information to third parties.',
      'We do not keep raw audio files after transcription.',
    ],
  },
  {
    id: 'utilisation',
    title: 'How we use your information',
    paragraphs: ['We use the information we collect to:'],
    list: [
      'Provide and maintain the App',
      'Authenticate your account',
      'Transcribe your meeting recordings using AI',
      'Generate structured reports and syntheses',
      'Send you important notifications (e.g. security alerts)',
      'Improve the App based on how it is used',
      'Fix bugs and ensure stability',
    ],
  },
  {
    id: 'sous-traitants',
    title: 'Third-party services',
    paragraphs: ['Our App relies on the following sub-processors:'],
    links: [
      { name: 'Supabase', purpose: 'Authentication and database', url: 'https://supabase.com/privacy' },
      { name: 'Mistral', purpose: 'Audio transcription and report generation', url: 'https://mistral.ai/fr/terms#privacy' },
      { name: 'PostHog', purpose: 'Analytics', url: 'https://posthog.com/privacy' },
      { name: 'Stripe', purpose: 'Payments', url: 'https://stripe.com/privacy' },
      { name: 'Sentry', purpose: 'Error tracking', url: 'https://sentry.io/privacy' },
      { name: 'Expo', purpose: 'Builds and updates', url: 'https://expo.dev/privacy' },
    ],
    note: 'A Data Processing Agreement (DPA) is available on request at support@reedly.ai.',
  },
  {
    id: 'stockage',
    title: 'Data storage and security',
    paragraphs: [
      'Your data is stored on secure servers provided by Supabase, hosted on AWS within the European Union.',
      'All data is encrypted in transit (TLS/SSL) and at rest.',
      'Audio recordings are processed in real time and are not permanently stored on our servers.',
      'We apply security measures in line with industry standards.',
    ],
  },
  {
    id: 'vos-droits',
    title: 'Your rights',
    paragraphs: ['You have the right to:'],
    list: [
      'Access your personal data',
      'Correct inaccurate data',
      'Delete your account and the data attached to it',
      'Export your data in a portable format',
      'Opt out of analytics tracking',
    ],
    after: ['To exercise these rights, contact us at support@reedly.ai.'],
  },
  {
    id: 'conservation',
    title: 'Data retention',
    paragraphs: [
      'Account data is kept for as long as your account is active.',
      'If you delete your account, your data is permanently deleted within 30 days.',
      'Anonymous analytics data may be kept indefinitely in aggregated form.',
    ],
  },
  {
    id: 'mineurs',
    title: 'Protection of minors',
    paragraphs: [
      'Our App is not intended for children under 13. We do not knowingly collect personal information from children under 13. If you believe we have collected such data, please contact us immediately.',
    ],
  },
  {
    id: 'modifications',
    title: 'Changes to this policy',
    paragraphs: [
      'We may update this Privacy Policy from time to time. We will notify you of any change by publishing the new policy on this page, updating the "Last updated" date, and sending an in-app notification for significant changes.',
    ],
  },
  {
    id: 'contact',
    title: 'Contact us',
    paragraphs: ['For any question about this Privacy Policy, contact us at support@reedly.ai.'],
  },
];
---

<Layout
  title="Privacy Policy · Reedly"
  description="How Reedly collects, uses and protects your data: information collected, sub-processors, EU storage, your rights and retention periods."
  lang="en"
  hreflang={{ fr: '/fr/confidentialite', en: '/en/privacy-policy' }}
>
  <Nav altHref="/fr/confidentialite" />
  <main>
    <LegalPage
      title="Privacy Policy"
      lastUpdated="Last updated: 18 February 2026"
      sections={sections}
      lang="en"
    />
  </main>
  <Footer />
  <script src="/main.js" is:inline></script>
</Layout>

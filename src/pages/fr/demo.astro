---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import BookDemo from '@/components/BookDemo.astro';
import Testimonials from '@/components/Testimonials.astro';
import Faq from '@/components/Faq.astro';
import Footer from '@/components/Footer.astro';
import { t } from '@/lib/i18n';

const breadcrumb = [
  { name: t('fr', 'bookpage.home'), path: '/fr' },
  { name: t('fr', 'cta.book_demo') },
];
---

<Layout
  title={t('fr', 'bookpage.meta_title')}
  description={t('fr', 'bookpage.meta_description')}
  lang="fr"
  hreflang={{ fr: '/fr/demo', en: '/en/demo' }}
  breadcrumb={breadcrumb}
>
  <Nav altHref="/en/demo" />

  <main>
    <BookDemo />
    <Testimonials />
    <Faq white />
  </main>

  <Footer />

  <script src="/main.js" is:inline></script>
</Layout>

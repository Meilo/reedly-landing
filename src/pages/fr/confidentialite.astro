---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import LegalPage from '@/components/LegalPage.astro';
import Footer from '@/components/Footer.astro';

const sections = [
  {
    id: 'introduction',
    title: 'Introduction',
    paragraphs: [
      "Reedly (« nous », « notre ») exploite l'application mobile Reedly (l'Application). Cette Politique de confidentialité explique comment nous collectons, utilisons et protégeons vos informations lorsque vous utilisez notre Application.",
      "Reedly est un outil d'enregistrement de réunions et de génération de rapports conçu pour les professionnels. En utilisant l'Application, vous acceptez la collecte et l'utilisation des informations conformément à cette politique.",
    ],
  },
  {
    id: 'informations-collectees',
    title: 'Informations collectées',
    paragraphs: [
      "<b>Informations de compte</b> : lors de la création de votre compte, nous collectons votre adresse email, votre pseudonyme, et éventuellement vos nom et prénom.",
      "<b>Données de profil</b> : toute information que vous ajoutez à votre profil, y compris votre nom et votre avatar.",
      "<b>Enregistrements audio</b> : lorsque vous utilisez la fonction d'enregistrement, l'audio est temporairement traité pour générer des transcriptions et des rapports structurés. Les fichiers audio sont envoyés à Mistral pour la transcription.",
      "<b>Contenu généré</b> : les rapports et synthèses créés à partir de vos enregistrements sont stockés dans votre compte.",
      "<b>Données d'utilisation</b> : nous collectons des données d'utilisation anonymes (écrans visités, fonctionnalités utilisées) pour améliorer l'Application via PostHog.",
      "<b>Informations sur l'appareil</b> : type d'appareil, version du système d'exploitation et version de l'application.",
    ],
  },
  {
    id: 'non-collectees',
    title: 'Informations que nous ne collectons pas',
    list: [
      'Nous ne collectons pas de données de localisation précise.',
      "Nous n'accédons pas à vos contacts, calendrier ou autres données personnelles.",
      'Nous ne vendons pas vos informations personnelles à des tiers.',
      'Nous ne conservons pas les fichiers audio bruts après la transcription.',
    ],
  },
  {
    id: 'utilisation',
    title: 'Utilisation de vos informations',
    paragraphs: ['Nous utilisons les informations collectées pour :'],
    list: [
      "Fournir et maintenir l'Application",
      'Authentifier votre compte',
      "Transcrire vos enregistrements de réunions via l'IA",
      'Générer des rapports structurés et des synthèses',
      'Vous envoyer des notifications importantes (ex. alertes de sécurité)',
      "Améliorer l'Application en fonction des usages",
      'Corriger les bugs et assurer la stabilité',
    ],
  },
  {
    id: 'sous-traitants',
    title: 'Services tiers',
    paragraphs: ['Notre Application utilise les sous-traitants suivants :'],
    links: [
      { name: 'Supabase', purpose: 'Authentification et base de données', url: 'https://supabase.com/privacy' },
      { name: 'Mistral', purpose: 'Transcription audio et génération de rapports', url: 'https://mistral.ai/fr/terms#privacy' },
      { name: 'PostHog', purpose: 'Analytique', url: 'https://posthog.com/privacy' },
      { name: 'Stripe', purpose: 'Paiements', url: 'https://stripe.com/privacy' },
      { name: 'Sentry', purpose: 'Suivi des erreurs', url: 'https://sentry.io/privacy' },
      { name: 'Expo', purpose: 'Build et mises à jour', url: 'https://expo.dev/privacy' },
    ],
    note: 'Un accord de traitement des données (DPA) est disponible sur demande à support@reedly.ai.',
  },
  {
    id: 'stockage',
    title: 'Stockage et sécurité des données',
    paragraphs: [
      'Vos données sont stockées sur des serveurs sécurisés fournis par Supabase, hébergés sur AWS dans l\'Union européenne.',
      'Toutes les données sont chiffrées en transit (TLS/SSL) et au repos.',
      'Les enregistrements audio sont traités en temps réel et ne sont pas stockés de manière permanente sur nos serveurs.',
      "Nous mettons en œuvre des mesures de sécurité conformes aux standards de l'industrie.",
    ],
  },
  {
    id: 'vos-droits',
    title: 'Vos droits',
    paragraphs: ['Vous avez le droit de :'],
    list: [
      'Accéder à vos données personnelles',
      'Corriger des données inexactes',
      'Supprimer votre compte et les données associées',
      'Exporter vos données dans un format portable',
      'Refuser le suivi analytique',
    ],
    note: 'Pour exercer ces droits, contactez-nous à support@reedly.ai.',
  },
  {
    id: 'conservation',
    title: 'Conservation des données',
    paragraphs: [
      'Les données de compte sont conservées tant que votre compte est actif.',
      'Si vous supprimez votre compte, vos données sont définitivement supprimées sous 30 jours.',
      'Les données analytiques anonymes peuvent être conservées indéfiniment sous forme agrégée.',
    ],
  },
  {
    id: 'mineurs',
    title: 'Protection des mineurs',
    paragraphs: [
      "Notre Application n'est pas destinée aux enfants de moins de 13 ans. Nous ne collectons pas sciemment d'informations personnelles auprès d'enfants de moins de 13 ans. Si vous pensez que nous avons collecté de telles données, veuillez nous contacter immédiatement.",
    ],
  },
  {
    id: 'modifications',
    title: 'Modifications de cette politique',
    paragraphs: [
      "Nous pouvons mettre à jour cette Politique de confidentialité de temps à autre. Nous vous informerons de tout changement en publiant la nouvelle politique sur cette page, en mettant à jour la date de « Dernière mise à jour » et en envoyant une notification via l'Application pour les changements importants.",
    ],
  },
  {
    id: 'contact',
    title: 'Nous contacter',
    paragraphs: [
      'Pour toute question concernant cette Politique de confidentialité, contactez-nous à support@reedly.ai.',
    ],
  },
];
---

<Layout
  title="Politique de confidentialité · Reedly"
  description="Comment Reedly collecte, utilise et protège vos données : informations collectées, sous-traitants, stockage dans l'UE, vos droits et durées de conservation."
  lang="fr"
  hreflang={{ fr: '/fr/confidentialite', en: '/en/privacy-policy' }}
>
  <Nav altHref="/en/privacy-policy" />
  <main>
    <LegalPage
      title="Politique de confidentialité"
      lastUpdated="Dernière mise à jour : 18 février 2026"
      sections={sections}
      lang="fr"
    />
  </main>
  <Footer />
  <script src="/main.js" is:inline></script>
</Layout>

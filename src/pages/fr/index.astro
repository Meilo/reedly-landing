---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import Demo from '@/components/Demo.astro';
import Hub from '@/components/Hub.astro';
import Compliance from '@/components/Compliance.astro';
import Pricing from '@/components/Pricing.astro';
import Testimonials from '@/components/Testimonials.astro';
import BookDemo from '@/components/BookDemo.astro';
import Faq from '@/components/Faq.astro';
import FinalCta from '@/components/FinalCta.astro';
import Footer from '@/components/Footer.astro';
---

<Layout hreflang={{ fr: '/fr', en: '/en' }} intro>
  <Nav altHref="/en" />

  <main>
    <Hero />
    <Demo />
    <Hub />
    <Compliance />
    <Pricing />
    <Testimonials />
    <BookDemo />
    <Faq />
    <FinalCta />
  </main>

  <Footer />

  <script src="/main.js" is:inline></script>
</Layout>
